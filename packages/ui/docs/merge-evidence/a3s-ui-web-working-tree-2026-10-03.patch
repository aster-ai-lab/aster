-          </div>
-        </div>
-        <div
-          className="os-overview__token-filters"
-          data-custom={rangeId === 'custom' ? 'true' : undefined}
-        >
-          <SearchSelect
-            className="os-overview__token-filter"
-            size="sm"
-            searchable={false}
-            allowClear={false}
-            value={rangeId}
-            options={rangeOptions}
-            onChange={onRangeChange}
-            aria-label={t('overview.tokens.filter.range')}
-          />
