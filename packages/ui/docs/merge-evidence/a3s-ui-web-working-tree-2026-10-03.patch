-/**
- * 解析管线（原型内模拟 worker）：pending → parsing → parsed/failed。
- * 后端接入后以真实任务队列替换 scheduleParse 的定时器，状态迁移保持不变。
- */
-type ParseTimer = ReturnType<typeof setTimeout>;
-const parseTimers = new Map<string, ParseTimer[]>();
