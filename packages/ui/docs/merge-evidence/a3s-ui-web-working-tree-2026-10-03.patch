-function queryTokens(query: string): string[] {
-  const tokens: string[] = [];
-  for (const part of query.trim().toLowerCase().split(/\s+/).filter(Boolean)) {
-    const cjk = /^[\u4e00-\u9fff]+$/.test(part);
-    if (cjk && part.length > 2) {
-      for (let index = 0; index < part.length - 1; index += 1) tokens.push(part.slice(index, index + 2));
-    } else {
-      tokens.push(part);
-    }
-  }
-  return tokens;
-}
-
-export function retrieve(bucket: HubBucket, query: string): { text: string; citations: string[] } {
-  const tokens = queryTokens(query);
-  if (tokens.length === 0) return { text: '', citations: [] };
-  const ranked = bucket.docs
-    .map((doc) => {
-      const hay = `${doc.name}\n${doc.text}\n${doc.tags}`.toLowerCase();
-      const score = tokens.filter((token) => hay.includes(token)).length;
-      return { doc, score };
-    })
-    .filter((hit) => hit.score > 0)
-    .sort((left, right) => right.score - left.score);
-  if (ranked.length === 0) return { text: '', citations: [] };
-  const best = ranked[0].score;
-  const hits = ranked.filter((hit) => hit.score === best).map((hit) => hit.doc);
-  return {
-    citations: hits.map((doc) => doc.name),
-    text: hits.map((doc) => doc.text.trim()).filter(Boolean).join('\n\n'),
-  };
-}
