-
-export const AbilityContext = createContext<Ability>(EMPTY_ABILITY);
-
-export function useAbility(): Ability {
-  return useContext(AbilityContext);
-}
-
-type CanProps = {
-  /** Action, as in CASL `<Can I="approve" a="JoinRequest">`. */
-  I: string;
-  a?: string;
-  an?: string;
-  this?: string;
-  not?: boolean;
-  passThrough?: boolean;
-  children: ReactNode | ((allowed: boolean) => ReactNode);
-};
-
-/**
- * Renders children only when the current ability allows the action.
- * `passThrough` always renders a function child and passes whether it is allowed.
- */
-export function Can({
-  I,
-  a,
-  an,
-  this: subjectProp,
-  not = false,
-  passThrough = false,
-  children,
-}: CanProps) {
-  const ability = useAbility();
-  const subject = a ?? an ?? subjectProp ?? '';
-  const permitted = ability.can(I, subject);
-  const visible = not ? !permitted : permitted;
-  if (typeof children === 'function') {
-    if (passThrough || visible) return <>{children(permitted)}</>;
-    return null;
-  }
-  if (!visible) return null;
-  return <>{children}</>;
-}
