-/** 立即执行一次解析结论（测试与定时器共用；仅对排队/解析中的文档生效）。 */
-export function runParseNow(scope: string, id: string) {
-  const current = bucketOf(scope);
-  const doc = current.docs.find((item) => item.id === id);
-  if (!doc || (doc.status !== 'pending' && doc.status !== 'parsing')) return;
-  const ok = doc.text.trim().length > 0;
-  commit(scope, {
-    ...current,
-    docs: current.docs.map((item) =>
-      item.id === id
-        ? ok
-          ? { ...item, status: 'parsed' as const, error: undefined, parsedAt: now(), updatedAt: now() }
-          : { ...item, status: 'failed' as const, error: 'org.hub.files.parseEmpty' as const, updatedAt: now() }
-        : item,
-    ),
-  });
-}
