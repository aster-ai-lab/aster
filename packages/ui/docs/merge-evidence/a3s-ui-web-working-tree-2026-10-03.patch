-            variant="modal"
-            showTrigger={false}
-            open={customRangeOpen}
-            onOpenChange={onCustomRangeOpenChange}
-            value={customRange}
-            onChange={(next) => {
-              customCommittedRef.current = true;
-              setCustomRange(next);
-              setRangeId('custom');
-            }}
-            mode="datetime"
-            title={t('overview.tokens.filter.customRange')}
-            startLabel={t('overview.tokens.range.start')}
-            endLabel={t('overview.tokens.range.end')}
-            confirmLabel={t('overview.tokens.range.confirm')}
-            cancelLabel={t('overview.tokens.range.cancel')}
-            preset30dLabel={t('overview.tokens.range.30d')}
-            weekdayLabels={weekdayLabels}
-            aria-label={t('overview.tokens.filter.customRange')}
-          />
-        </div>
-      </div>
-      <TokenHeatmap
-        className="os-overview__heatmap"
-        weeks={summary.weeks}
-        lessLabel={t('overview.tokens.legend.less')}
-        moreLabel={t('overview.tokens.legend.more')}
-        tokensLabel={t('org.usage.tokens')}
-        formatTokens={formatTokens}
-        weekdayLabels={weekdayLabels}
-      />
-    </section>
-  );
-}
-
-function usageWindow(rangeId: string, custom: { start: string; end: string }) {
-  if (rangeId === 'custom' && custom.start.slice(0, 10) && custom.end.slice(0, 10)) {
-    const start = new Date(`${custom.start.slice(0, 10)}T12:00:00`);
-    const end = new Date(`${custom.end.slice(0, 10)}T12:00:00`);
-    const span = Math.min(
-      366,
-      Math.max(1, Math.round((end.getTime() - start.getTime()) / 86_400_000) + 1),
-    );
-    return { span, end };
-  }
-  return {
-    span: daysForRange(rangeId === 'custom' ? '30d' : rangeId),
-    end: new Date(),
-  };
-}
-
-function formatTokens(n: number) {
-  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
-  if (n >= 1_000) return `${(n / 1_000).toFixed(1)}k`;
-  return String(n);
-}
-
-function TokenIcon() {
-  return (
-    <svg
-      width={18}
-      height={18}
-      viewBox="0 0 24 24"
-      fill="none"
-      stroke="currentColor"
-      strokeWidth={1.75}
-      strokeLinecap="round"
-      strokeLinejoin="round"
-      aria-hidden
-    >
-      <rect x="4" y="5" width="16" height="14" rx="2" />
-      <path d="M8 9h8" />
-      <path d="M8 13h5" />
-    </svg>
-  );
-}
-
-function mergeDays(rows: UsageSummary[]) {
-  const totals = new Map<string, number>();
-  for (const row of rows) {
-    for (const day of row.by_day) {
-      totals.set(day.day, (totals.get(day.day) ?? 0) + day.tokens);
-    }
-  }
-  return [...totals.entries()].map(([day, tokens]) => ({ day, tokens }));
-}
