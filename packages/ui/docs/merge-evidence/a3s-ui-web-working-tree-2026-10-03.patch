-function asRecord(value: unknown): Record<string, unknown> {
-  return value && typeof value === 'object' ? (value as Record<string, unknown>) : {};
-}
-
-function str(raw: Record<string, unknown>, ...keys: string[]): string {
-  for (const key of keys) {
-    const value = raw[key];
-    if (typeof value === 'string') return value;
-  }
-  return '';
-}
-
-function num(raw: Record<string, unknown>, ...keys: string[]): number {
-  for (const key of keys) {
-    const value = raw[key];
-    if (typeof value === 'number' && Number.isFinite(value)) return value;
-    if (typeof value === 'string' && value.trim()) {
-      const parsed = Number(value);
-      if (Number.isFinite(parsed)) return parsed;
-    }
-  }
-  return 0;
-}
-
-function asKind(value: string): ResourcePackageKind {
-  if (RESOURCE_PACKAGE_KINDS.includes(value as ResourcePackageKind)) {
-    return value as ResourcePackageKind;
-  }
-  return 'tool';
-}
-
-function normalizeSummary(raw: Record<string, unknown>): PackageSummary {
-  const latest = str(raw, 'latestVersion', 'latest_version');
-  return {
-    id: str(raw, 'id'),
-    kind: asKind(str(raw, 'kind')),
-    name: str(raw, 'name'),
-    description: str(raw, 'description'),
-    latestVersion: latest || null,
-    versionCount: num(raw, 'versionCount', 'version_count'),
-    updatedAt: str(raw, 'updatedAt', 'updated_at'),
-  };
-}
-
-function normalizeVersion(raw: Record<string, unknown>): PackageVersion {
-  return {
-    id: str(raw, 'id'),
-    packageId: str(raw, 'packageId', 'package_id'),
-    version: str(raw, 'version'),
-    digest: str(raw, 'digest'),
-    sizeBytes: num(raw, 'sizeBytes', 'size_bytes'),
-    yanked: Boolean(raw.yanked),
-    changelog: str(raw, 'changelog'),
-    publishedAt: str(raw, 'publishedAt', 'published_at'),
-  };
-}
-
-function normalizeDetail(raw: Record<string, unknown>): PackageDetail {
-  const versionsRaw = raw.versions;
-  const versions = Array.isArray(versionsRaw)
-    ? versionsRaw.map((item) => normalizeVersion(asRecord(item)))
