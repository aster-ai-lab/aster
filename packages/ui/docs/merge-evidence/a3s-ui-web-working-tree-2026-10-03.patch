-/** One CASL rule: `can(action, subject)`. `manage` and `all` are wildcards. */
-export type AccessRule = {
-  action: string;
-  subject: string;
-};
-
-/**
- * Small ability, matching the CASL check used by `<Can I a>`.
- * `manage` allows every action. `all` allows every subject.
- */
-export class Ability {
-  constructor(
-    private readonly rules: readonly AccessRule[] = [],
-    private readonly inverted: readonly AccessRule[] = [],
-  ) {}
-
-  can(action: string, subject: string): boolean {
-    if (this.matches(this.inverted, action, subject)) return false;
-    return this.matches(this.rules, action, subject);
-  }
-
-  cannot(action: string, subject: string): boolean {
-    return !this.can(action, subject);
-  }
-
-  private matches(rules: readonly AccessRule[], action: string, subject: string): boolean {
-    return rules.some(
-      (rule) =>
-        (rule.action === 'manage' || rule.action === action) &&
-        (rule.subject === 'all' || rule.subject === subject),
-    );
-  }
-}
-
-export const EMPTY_ABILITY = new Ability();
-
-type RuleFn = (action: string, subject: string) => void;
-
-/** CASL `defineAbility((can, cannot) => { ... })`. */
-export function defineAbility(define: (can: RuleFn, cannot: RuleFn) => void): Ability {
-  const rules: AccessRule[] = [];
-  const inverted: AccessRule[] = [];
-  define(
-    (action, subject) => rules.push({ action, subject }),
-    (action, subject) => inverted.push({ action, subject }),
-  );
-  return new Ability(rules, inverted);
-}
