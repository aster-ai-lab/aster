-#!/usr/bin/env bash
-# 知识库详情页冒烟回归（规划 S1-2 的可运行形态；a3s ACL 规约见同目录 hub-smoke.acl）。
-#
-# 用法：cd apps/web && tests/e2e/hub-smoke.sh [BASE_URL]
-# 前置：dev server 已运行（默认 http://127.0.0.1:3101），开发验证码回显可用（DEV 构建 + dev SMS echo）。
-# 说明：登录走开发态验证码回显（动态捕获 toast）；断言间用固定短等待，属冒烟级而非精确时序级。
-# 注意：后端对发码有 60s 限频——连续两次运行需间隔一分钟以上，否则 "dev code not revealed"。
-set -uo pipefail
-
-URL="${1:-http://127.0.0.1:3101}"
-PASS=0
-FAIL=0
-
-cleanup() { agent-browser close --all >/dev/null 2>&1 || true; }
-trap cleanup EXIT
-
-ev() { agent-browser eval "$1" 2>/dev/null; }
-
-# check <名称> <eval 表达式期望输出 true>——轮询重试，吸收 React 异步渲染的竞态
-check() {
-  local name="$1" expr="$2" got="" attempt
-  for attempt in 1 2 3 4 5 6; do
-    got="$(ev "$expr")"
-    if [[ "$got" == *'"true"'* || "$got" == *"true"* ]]; then
-      echo "ok: $name"; PASS=$((PASS + 1)); return 0
-    fi
-    sleep 0.3
-  done
-  echo "FAIL: $name (got: ${got:0:120})"; FAIL=$((FAIL + 1))
-}
-
-gotosleep() { sleep "${SMOKE_WAIT:-1.2}"; }
-
-echo "== hub smoke against $URL =="
-
-do_login() {
-  agent-browser close --all >/dev/null 2>&1 || true; sleep 1
-  agent-browser open "$URL/login" >/dev/null 2>&1; gotosleep
-  ev "(()=>{const t=document.querySelectorAll('input')[0];const s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;s.call(t,'13800000001');t.dispatchEvent(new Event('input',{bubbles:true}));return true})()" >/dev/null
-  ev "Array.from(document.querySelectorAll('button')).find(b=>b.textContent.includes('发送验证码'))?.click();true" >/dev/null
-  gotosleep
-  local code="$(agent-browser snapshot 2>/dev/null | grep -oE '开发验证码 [0-9]{6}' | grep -oE '[0-9]{6}' | head -1)"
-  [[ -z "$code" ]] && return 1
-  ev "(()=>{const t=document.querySelectorAll('input')[1];const s=Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype,'value').set;s.call(t,'$code');t.dispatchEvent(new Event('input',{bubbles:true}));return true})()" >/dev/null
-  ev "Array.from(document.querySelectorAll('button')).find(b=>b.textContent.trim()==='登录 / 注册')?.click();true" >/dev/null
-  gotosleep; gotosleep
-  agent-browser get url 2>/dev/null | grep -qE '/$|/hub'
-}
-
-# --- 登录（开发态验证码回显）；失败自动重试一次 ---
-if do_login; then
-  echo "ok: login lands"; PASS=$((PASS+1))
-else
-  echo "retry: login (dev code cooldown or race)"; sleep 66
-  if do_login; then echo "ok: login lands (retry)"; PASS=$((PASS+1)); else echo "FAIL: login lands"; FAIL=$((FAIL+1)); fi
-fi
-
-# 重置工作台存储：每轮从确定性种子开始（多轮冒烟的移动/删除/重命名会累积漂移）。
-# reload 后若遇请求竞态掉登录（useOrgMember 兜底清 token），自动补一次登录。
-# 不用 reload：重载会重放认证请求，撞上 dev server 冷启动竞态会清掉会话。
-# hub 是纯前端存储，清空后直接重新打开页面即可重新播种。
-ev "localStorage.removeItem('kense.org.hub.v1'); true" >/dev/null
-agent-browser open "$URL/hub/bases/hub_base_handbook/documents" >/dev/null 2>&1; gotosleep
-
-# --- 文档页：详情渲染 + tab 徽标 + 警示点容器 ---
-check "base detail renders" "document.body.textContent.includes('产品手册')"
-# 布局断言（防破版回归）：工具栏紧贴顶栏（间距 < 16px），文件区高度显著大于工具栏
-check "layout: toolbar sits under topbar" "(()=>{const t=document.querySelector('.os-hub-files__top'),b=document.querySelector('.os-hub-files__toolbar');if(!t||!b)return false;return b.getBoundingClientRect().top - t.getBoundingClientRect().bottom < 16})()"
-check "layout: viewport fills remaining space" "(()=>{const v=document.querySelector('.os-hub-files__viewport'),b=document.querySelector('.os-hub-files__toolbar');if(!v||!b)return false;return v.getBoundingClientRect().height > b.getBoundingClientRect().height * 3})()"
-check "layout: crumbs stay on one line" "(()=>{const c=document.querySelector('.os-hub-files__crumbs');if(!c)return false;const first=c.querySelector('button, strong');if(!first)return false;return Math.abs(first.getBoundingClientRect().top - c.getBoundingClientRect().top) < 8})()"
-
-# --- 文档工作台：进入文件夹 → 打开 → Escape 关闭 → 焦点回归 ---
-ev "(()=>{const d=document.querySelector('[data-key^=dir]');d?.dispatchEvent(new MouseEvent('dblclick',{bubbles:true}));return true})()" >/dev/null; gotosleep
