- * Capability Key (≡ inference credential) — Console preview store until R6
- * wires kense-cloud Identity credentials. Not an authority for Gateway ACL.
- */
-
-export type CapabilityKeyStatus = 'active' | 'revoked';
-
-export type CapabilityKey = {
-  id: string;
-  name: string;
-  /** Public prefix shown in lists (never full secret after create). */
-  prefix: string;
-  status: CapabilityKeyStatus;
-  createdAtEpoch: number;
-  lastUsedAtEpoch?: number;
-  /** Only set at create time for one-shot reveal. */
-  secret?: string;
-};
-
-const keys: CapabilityKey[] = [
-  {
-    id: 'ck_demo_work',
-    name: 'Work default',
-    prefix: 'kense_sk_work',
-    status: 'active',
-    createdAtEpoch: Math.floor(Date.now() / 1000) - 86400 * 3,
-  },
-];
-
-function randomSecret(): string {
-  const body = Array.from(crypto.getRandomValues(new Uint8Array(18)))
-    .map((b) => b.toString(16).padStart(2, '0'))
-    .join('');
-  return `kense_sk_${body}`;
-}
-
-export function listCapabilityKeys(): CapabilityKey[] {
-  return keys
-    .map(({ secret: _s, ...rest }) => ({ ...rest }))
-    .sort((a, b) => b.createdAtEpoch - a.createdAtEpoch);
-}
-
-export function createCapabilityKey(name: string): CapabilityKey {
-  const secret = randomSecret();
-  const prefix = secret.slice(0, 14);
-  const row: CapabilityKey = {
-    id: `ck_${Date.now().toString(36)}`,
-    name: name.trim() || 'Capability Key',
-    prefix,
-    status: 'active',
-    createdAtEpoch: Math.floor(Date.now() / 1000),
-    secret,
-  };
-  keys.unshift(row);
-  return { ...row };
-}
-
-export function revokeCapabilityKey(id: string): boolean {
-  const hit = keys.find((k) => k.id === id);
-  if (!hit || hit.status === 'revoked') return false;
-  hit.status = 'revoked';
-  delete hit.secret;
-  return true;
-}
-
-export function rotateCapabilityKey(id: string): CapabilityKey | undefined {
-  const hit = keys.find((k) => k.id === id);
-  if (!hit || hit.status !== 'active') return undefined;
-  hit.status = 'revoked';
-  delete hit.secret;
-  return createCapabilityKey(`${hit.name} (rotated)`);
-}
