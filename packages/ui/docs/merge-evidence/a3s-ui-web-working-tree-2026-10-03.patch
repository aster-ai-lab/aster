-/** 旧数据迁移（幂等）：补 `updatedAt`、丢弃无归属产物。独立导出供测试锁定幂等性。 */
-export function migrateBucket(bucket: HubBucket): HubBucket {
-  let changed = false;
-  let bases = bucket.bases.map((base) => {
-    const tags = Array.isArray(base.tags) ? base.tags : [];
-    const category = base.category || 'general';
-    if (base.category === category && base.tags === tags) return base;
-    changed = true;
-    return { ...base, category, tags };
-  });
-  let categories = Array.isArray(bucket.categories)
-    ? bucket.categories.filter((row) => row && typeof row.id === 'string' && row.id.trim())
-    : [];
-  if (categories.length === 0) {
-    categories = defaultCategories();
-    changed = true;
-  }
-  let folders = Array.isArray(bucket.folders)
-    ? bucket.folders.filter((row) => row && typeof row.baseId === 'string' && typeof row.path === 'string' && row.path.trim())
-    : [];
-  if (!Array.isArray(bucket.folders) || folders.length !== bucket.folders.length) {
-    changed = true;
-  }
-  const ids = new Set(categories.map((row) => row.id));
-  const fallback = categories[0]?.id ?? 'general';
-  bases = bases.map((base) => {
-    if (ids.has(base.category)) return base;
-    changed = true;
-    return { ...base, category: fallback };
-  });
-  // 迁移：旧行补时间戳（以「字段是否存在」判定，空串视为已迁移，避免每遍重迁移导致
-  // getSnapshot 引用漂移 → useSyncExternalStore 无限循环）；产物按范围不变量归属到库，
-  // 无归属（旧全局产物）丢弃。
-  const baseIds = new Set(bases.map((base) => base.id));
-  const docIds = new Set(bucket.docs.map((doc) => doc.id));
-  const docs = bucket.docs.map((doc) => {
-    if (typeof doc.updatedAt === 'string') return doc;
-    changed = true;
-    return { ...doc, updatedAt: '' };
-  });
-  const wiki = bucket.wiki.map((page) => {
-    if (typeof page.updatedAt === 'string') return page;
-    changed = true;
-    return { ...page, updatedAt: '' };
-  });
-  const artifacts = (Array.isArray(bucket.artifacts) ? bucket.artifacts : [])
-    .filter((row) => typeof row.baseId === 'string' && baseIds.has(row.baseId));
-  const cleanedArtifacts = artifacts.map((row) => {
-    if (row.adoptedDocId && !docIds.has(row.adoptedDocId)) {
-      changed = true;
-      return { ...row, adoptedDocId: undefined };
-    }
-    return row;
-  });
-  if (!changed) {
-    const sameArtifacts =
-      artifacts.length === bucket.artifacts.length &&
-      cleanedArtifacts.every((row, index) => row === bucket.artifacts[index]);
-    if (!sameArtifacts) changed = true;
-  }
-  if (!changed) return bucket;
-  return { ...bucket, bases, categories, folders, docs, wiki, artifacts: cleanedArtifacts, compilations: bucket.compilations ?? [] };
-}
