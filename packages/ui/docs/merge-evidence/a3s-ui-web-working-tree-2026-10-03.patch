-
-  useEffect(() => {
-    let cancelled = false;
-    setLoaded(null);
-    setErrorKey(null);
-    const joined = orgs;
-    if (joined.length === 0) {
-      setLoaded({ free: [], builder: null });
-      return;
-    }
-    Promise.all(
-      joined.map(async (org) => {
-        const [subscription, usage] = await Promise.all([
-          fetchOrgSubscription(org.id),
-          fetchOrgUsage(org.id, USAGE_DAYS),
-        ]);
-        return { org, subscription, usage };
-      }),
