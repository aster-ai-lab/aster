-/** 相邻百科版本的行级对比。LCS 对齐，输出按原文顺序交错的 same/del/add 行。 */
-
-export type DiffRow = { type: 'same' | 'add' | 'del'; text: string };
-
-const MAX_CELLS = 1_000_000;
-
-export function diffLines(before: string, after: string): DiffRow[] {
-  const left = before ? before.replace(/\r\n?/g, '\n').split('\n') : [];
-  const right = after ? after.replace(/\r\n?/g, '\n').split('\n') : [];
-  if (left.length * right.length > MAX_CELLS) {
-    return [
-      ...left.map((text): DiffRow => ({ type: 'del', text })),
-      ...right.map((text): DiffRow => ({ type: 'add', text })),
-    ];
-  }
-  const lcs: number[][] = Array.from({ length: left.length + 1 }, () =>
-    new Array<number>(right.length + 1).fill(0),
-  );
-  for (let i = left.length - 1; i >= 0; i -= 1) {
-    for (let j = right.length - 1; j >= 0; j -= 1) {
-      lcs[i]![j] =
-        left[i] === right[j]
-          ? lcs[i + 1]![j + 1]! + 1
-          : Math.max(lcs[i + 1]![j]!, lcs[i]![j + 1]!);
-    }
-  }
-  const rows: DiffRow[] = [];
-  let i = 0;
-  let j = 0;
-  while (i < left.length && j < right.length) {
-    if (left[i] === right[j]) {
-      rows.push({ type: 'same', text: left[i]! });
-      i += 1;
-      j += 1;
-    } else if (lcs[i + 1]![j]! >= lcs[i]![j + 1]!) {
-      rows.push({ type: 'del', text: left[i]! });
-      i += 1;
-    } else {
-      rows.push({ type: 'add', text: right[j]! });
-      j += 1;
-    }
-  }
-  while (i < left.length) {
-    rows.push({ type: 'del', text: left[i]! });
-    i += 1;
-  }
-  while (j < right.length) {
-    rows.push({ type: 'add', text: right[j]! });
-    j += 1;
-  }
-  return rows;
-}
