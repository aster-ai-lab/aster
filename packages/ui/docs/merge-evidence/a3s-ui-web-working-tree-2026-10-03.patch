-import { useEffect, useSyncExternalStore } from 'react';
-import type { TokenDay } from '@/data/platformTokens';
-import { getOrgMemberToken, listMyOrgs, type MemberOrg } from '@/lib/orgApi';
-
-/** 未选企业时停留在个人中心。 */
-export const PERSONAL_CENTER = 'personal';
-
-const STORAGE_KEY = 'kense.org.center';
-export const USAGE_DAYS = 93;
-
-type CenterState = {
-  centerId: string;
-  orgs: MemberOrg[] | null;
-  status: 'loading' | 'ready' | 'error';
-  /** 401（个人中心未登录/登录过期）。管理后台的目录页据此给登录引导，而不是笼统的失败文案。 */
-  unauthenticated: boolean;
-};
-
-let requestId = 0;
-
-function readStoredCenter() {
-  try {
-    const stored = localStorage.getItem(STORAGE_KEY);
-    return stored && stored.trim() ? stored : PERSONAL_CENTER;
-  } catch {
-    return PERSONAL_CENTER;
-  }
-}
-
-function writeStoredCenter(id: string) {
-  try {
-    localStorage.setItem(STORAGE_KEY, id);
-  } catch {
-    /* private mode */
-  }
-}
-
-let state: CenterState = {
-  centerId: readStoredCenter(),
-  orgs: null,
-  status: 'loading',
-  unauthenticated: false,
-};
-
-const listeners = new Set<() => void>();
-
-function emit() {
-  for (const listener of listeners) listener();
-}
-
-function subscribe(listener: () => void) {
-  listeners.add(listener);
-  return () => listeners.delete(listener);
-}
-
-function getSnapshot() {
-  return state;
-}
-
-function reconcile(orgs: MemberOrg[]) {
-  const selectable = orgs.filter((org) => org.membership !== 'pending');
-  const known = state.centerId === PERSONAL_CENTER || selectable.some((org) => org.id === state.centerId);
-  const centerId = known ? state.centerId : PERSONAL_CENTER;
-  if (centerId !== state.centerId) writeStoredCenter(centerId);
-  state = { centerId, orgs, status: 'ready', unauthenticated: false };
-  emit();
-}
-
-let loading: Promise<void> | null = null;
-
-function ensureOrgs() {
-  if (state.status === 'ready' || loading) return loading ?? Promise.resolve();
-  const id = ++requestId;
-  state = { ...state, status: 'loading' };
-  emit();
-  loading = listMyOrgs()
-    .then((orgs) => {
-      if (id !== requestId) return;
-      reconcile(orgs);
-    })
-    .catch(() => {
-      if (id !== requestId) return;
-      // orgRequest 在 401 时会清掉 token；token 不在了即未登录，供目录页给登录引导。
-      state = {
-        ...state,
-        orgs: [],
-        status: 'error',
-        unauthenticated: !getOrgMemberToken(),
-      };
-      emit();
-    })
-    .finally(() => {
-      loading = null;
-    });
-  return loading;
-}
-
-/** 创建或加入企业后刷新列表，不把侧栏打回加载态。 */
-export function refreshOrgList() {
-  const id = ++requestId;
-  loading = listMyOrgs()
-    .then((orgs) => {
-      if (id !== requestId) return;
-      reconcile(orgs);
-    })
-    .catch(() => {
-      if (id !== requestId) return;
-      state = {
-        ...state,
-        orgs: state.orgs ?? [],
-        status: state.orgs ? state.status : 'error',
-        unauthenticated: state.orgs ? false : !getOrgMemberToken(),
-      };
-      emit();
-    })
-    .finally(() => {
-      if (id === requestId) loading = null;
-    });
-  return loading;
-}
-
-export function selectOrgCenter(centerId: string) {
-  if (centerId === state.centerId) return;
-  writeStoredCenter(centerId);
-  state = { ...state, centerId };
-  emit();
-}
-
-export function resetOrgCenter() {
-  requestId += 1;
-  loading = null;
-  state = {
-    centerId: readStoredCenter(),
-    orgs: null,
-    status: 'loading',
-    unauthenticated: false,
-  };
-  emit();
-}
-
-export function useOrgCenter() {
-  const snapshot = useSyncExternalStore(subscribe, getSnapshot, getSnapshot);
-  useEffect(() => {
-    void ensureOrgs();
-  }, []);
-  const org =
-    snapshot.centerId === PERSONAL_CENTER
-      ? null
-      : snapshot.orgs?.find((row) => row.id === snapshot.centerId) ?? null;
-  return { ...snapshot, org, select: selectOrgCenter };
-}
-
-function dayKey(date: Date) {
-  const month = String(date.getMonth() + 1).padStart(2, '0');
-  const day = String(date.getDate()).padStart(2, '0');
-  return `${date.getFullYear()}-${month}-${day}`;
-}
-
-function levelFor(tokens: number, peak: number): TokenDay['level'] {
-  if (tokens <= 0 || peak <= 0) return 0;
-  const ratio = tokens / peak;
-  if (ratio < 0.2) return 1;
-  if (ratio < 0.45) return 2;
-  if (ratio < 0.7) return 3;
-  return 4;
-}
-
-/** Sunday-aligned calendar ending on `endAt` (today when omitted). Missing days are zero. */
-export function buildUsageHeatmap(
-  rows: { day: string; tokens: number }[],
-  span = USAGE_DAYS,
-  endAt?: Date,
-) {
-  const totals = new Map(rows.map((row) => [row.day, row.tokens]));
-  const end = endAt ? new Date(endAt) : new Date();
-  end.setHours(12, 0, 0, 0);
-  const today = new Date();
-  today.setHours(12, 0, 0, 0);
-  if (end > today) end.setTime(today.getTime());
-  const start = new Date(end);
-  start.setDate(end.getDate() - (span - 1));
-
-  const days: TokenDay[] = [];
-  let peak = 0;
-  const cursor = new Date(start);
-  while (cursor <= end) {
-    const tokens = totals.get(dayKey(cursor)) ?? 0;
-    peak = Math.max(peak, tokens);
-    days.push({ date: dayKey(cursor), tokens, level: 0 });
-    cursor.setDate(cursor.getDate() + 1);
-  }
-  const leveled = days.map((day) => ({ ...day, level: levelFor(day.tokens, peak) }));
-  const total = leveled.reduce((sum, day) => sum + day.tokens, 0);
-
-  const pad = new Date(`${leveled[0]?.date ?? dayKey(start)}T12:00:00`).getDay();
-  const cells: Array<TokenDay | null> = [
-    ...Array.from({ length: pad }, () => null),
-    ...leveled,
-  ];
-  const weeks: TokenDay[][] = [];
-  for (let index = 0; index < cells.length; index += 7) {
-    const slice = cells.slice(index, index + 7);
-    while (slice.length < 7) slice.push(null);
-    weeks.push(slice.map((cell) => cell ?? { date: '', tokens: 0, level: 0 }));
-  }
-  return { weeks, total, columns: weeks.length };
-}
