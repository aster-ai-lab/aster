-import { createContext, useCallback, useContext, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
-import { Button, Dialog } from '@kense/ui';
-import { useI18n } from '@/i18n/useI18n';
-
-/**
- * 知识库详情页的编辑不丢守护（不变量 D）：工作面注册脏状态，
- * 一切会清掉编辑态的导航先经过 checkpoint()，由用户决定保存、放弃或留下。
- */
-
-export type DirtyHandler = { isDirty: () => boolean; save: () => void };
-
-type DirtyGuardApi = {
-  register: (handler: DirtyHandler | null) => void;
-  /** true = 可以离开；false = 用户取消。 */
-  checkpoint: () => Promise<boolean>;
-};
-
-const DirtyContext = createContext<DirtyGuardApi | null>(null);
-
-export function DirtyGuardProvider({ children }: { children: ReactNode }) {
-  const { t } = useI18n();
-  const handlerRef = useRef<DirtyHandler | null>(null);
-  const [pending, setPending] = useState<((proceed: boolean) => void) | null>(null);
-
-  const register = useCallback((handler: DirtyHandler | null) => {
-    handlerRef.current = handler;
-  }, []);
-
-  const checkpoint = useCallback(() => {
-    const handler = handlerRef.current;
-    if (!handler || !handler.isDirty()) return Promise.resolve(true);
-    return new Promise<boolean>((resolve) => {
-      setPending(() => resolve);
-    });
-  }, []);
-
-  const settle = useCallback(
-    (proceed: boolean, saveFirst: boolean) => {
-      if (proceed && saveFirst) handlerRef.current?.save();
-      pending?.(proceed);
-      setPending(null);
-    },
-    [pending],
-  );
-
-  const api = useMemo<DirtyGuardApi>(() => ({ register, checkpoint }), [register, checkpoint]);
-
-  return (
-    <DirtyContext.Provider value={api}>
-      {children}
-      <Dialog
-        open={pending !== null}
-        onOpenChange={(open) => {
-          if (!open) settle(false, false);
-        }}
-        title={t('org.hub.dirty.title')}
-        description={t('org.hub.dirty.hint')}
-        size="sm"
-        closeLabel={t('org.hub.dirty.stay')}
-        footer={
-          <>
-            <Button type="button" size="sm" variant="ghost" onClick={() => settle(false, false)}>
-              {t('org.hub.dirty.stay')}
-            </Button>
-            <Button type="button" size="sm" variant="outline" onClick={() => settle(true, false)}>
-              {t('org.hub.dirty.discard')}
-            </Button>
-            <Button type="button" size="sm" onClick={() => settle(true, true)}>
-              {t('org.hub.dirty.save')}
-            </Button>
-          </>
-        }
-      >
-        {null}
-      </Dialog>
-    </DirtyContext.Provider>
-  );
-}
-
-function useGuard(): DirtyGuardApi {
-  const ctx = useContext(DirtyContext);
-  if (!ctx) throw new Error('DirtyGuardProvider missing');
-  return ctx;
-}
-
-/** 工作面挂载时注册脏状态处理器，卸载时注销。 */
-export function useRegisterDirty(handler: DirtyHandler) {
-  const { register } = useGuard();
-  const ref = useRef(handler);
-  ref.current = handler;
-  useEffect(() => {
-    register({
-      isDirty: () => ref.current.isDirty(),
-      save: () => ref.current.save(),
-    });
-    return () => register(null);
-  }, [register]);
-}
-
-/** 导航前的检查点；工作面内部导航（切文件、切页面）也要经过。 */
-export function useDirtyCheckpoint() {
-  return useGuard().checkpoint;
-}
