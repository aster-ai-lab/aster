-/** 检索预演：只在本库内命中，给出得分最高的文档与命中的片段。 */
-export function retrieveInBase(bucket: HubBucket, baseId: string, query: string): RetrievalHit[] {
-  const tokens = queryTokens(query);
-  if (tokens.length === 0) return [];
-  return bucket.docs
-    .filter((doc) => doc.baseId === baseId && doc.status === 'parsed')
-    .map((doc) => {
-      const nameScore = tokens.filter((token) => doc.name.toLowerCase().includes(token)).length;
-      const tagScore = tokens.filter((token) => doc.tags.toLowerCase().includes(token)).length;
-      let excerpt = '';
-      let chunkScore = 0;
-      for (const chunk of chunkText(doc.text)) {
-        const hay = chunk.toLowerCase();
-        const score = tokens.filter((token) => hay.includes(token)).length;
-        if (score > chunkScore) {
-          chunkScore = score;
-          excerpt = chunk;
-        }
-      }
-      return { docId: doc.id, name: doc.name, score: nameScore + tagScore + chunkScore, excerpt };
-    })
-    .filter((hit) => hit.score > 0)
-    .sort((left, right) => right.score - left.score)
-    .slice(0, 8);
-}
