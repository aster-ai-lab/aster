diff --git a/apps/web/src/pages/org/billingLedger.ts b/apps/web/src/pages/org/billingLedger.ts
deleted file mode 100644
index 62e5c805..00000000
--- a/apps/web/src/pages/org/billingLedger.ts
+++ /dev/null
@@ -1,183 +0,0 @@
-import { useSyncExternalStore } from 'react';
-
-export type BillPlan = 'builder' | 'team';
-export type BillCycle = 'monthly' | 'annual';
-export type BillChannel = 'wechat' | 'alipay';
-export type ChargeStatus = 'pending' | 'paid' | 'closed';
-export type TitleType = 'personal' | 'company';
-
-export type Charge = {
-  id: string;
-  plan: BillPlan;
-  cycle: BillCycle;
-  seats: number;
-  amount: number;
-  channel: BillChannel;
-  status: ChargeStatus;
-  createdAt: number;
-  expiresAt: number;
-  invoiceId: string | null;
-};
-
-export type InvoiceRecord = {
-  id: string;
-  amount: number;
-  chargeIds: string[];
-  titleType: TitleType;
-  title: string;
-  taxNo: string;
-  email: string;
-  createdAt: number;
-  status: 'issuing';
-};
-
-export type InvoiceTitle = {
-  titleType: TitleType;
-  title: string;
-  taxNo: string;
-  email: string;
-};
-
-type Book = {
-  charges: Charge[];
-  invoices: InvoiceRecord[];
-  title: InvoiceTitle | null;
-};
-
-type Store = Record<string, Book>;
-
-const STORAGE_KEY = 'kense.org.billing';
-
-function emptyBook(): Book {
-  return { charges: [], invoices: [], title: null };
-}
-
-function readStore(): Store {
-  if (typeof localStorage === 'undefined') return {};
-  try {
-    const raw = localStorage.getItem(STORAGE_KEY);
-    if (!raw) return {};
-    const parsed = JSON.parse(raw) as Store;
-    return parsed && typeof parsed === 'object' ? parsed : {};
-  } catch {
-    return {};
-  }
-}
-
-let cache: Store = readStore();
-const listeners = new Set<() => void>();
-
-function getStore() {
-  return cache;
-}
-
-function emit(next: Store) {
-  cache = next;
-  try {
-    localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
-  } catch {
-    /* private mode or quota */
-  }
-  for (const listener of listeners) listener();
-}
-
-function subscribe(listener: () => void) {
-  listeners.add(listener);
-  return () => listeners.delete(listener);
-}
-
-function bookOf(store: Store, centerId: string): Book {
-  const row = store[centerId];
-  if (!row || !Array.isArray(row.charges) || !Array.isArray(row.invoices)) return emptyBook();
-  return row;
-}
-
-function sweep(book: Book, now = Date.now()): Book {
-  let changed = false;
-  const charges = book.charges.map((row) => {
-    if (row.status === 'pending' && row.expiresAt <= now) {
-      changed = true;
-      return { ...row, status: 'closed' as const };
-    }
-    return row;
-  });
-  return changed ? { ...book, charges } : book;
-}
-
-function commit(centerId: string, book: Book) {
-  emit({ ...getStore(), [centerId]: book });
-}
-
-/** Close payment attempts whose QR window has ended. */
-export function expirePending(centerId: string, now = Date.now()) {
-  const current = bookOf(getStore(), centerId);
-  const next = sweep(current, now);
-  if (next !== current) commit(centerId, next);
-}
-
-/** One open attempt per center. A new QR closes the previous unpaid one. */
-export function openPendingCharge(
-  centerId: string,
-  draft: Omit<Charge, 'status' | 'invoiceId'>,
-) {
-  const book = sweep(bookOf(getStore(), centerId));
-  const charges = book.charges.map((row) =>
-    row.status === 'pending' ? { ...row, status: 'closed' as const } : row,
-  );
-  charges.unshift({ ...draft, status: 'pending', invoiceId: null });
-  commit(centerId, { ...book, charges });
-}
-
-export function closeCharge(centerId: string, id: string) {
-  const book = bookOf(getStore(), centerId);
-  let changed = false;
-  const charges = book.charges.map((row) => {
-    if (row.id !== id || row.status !== 'pending') return row;
-    changed = true;
-    return { ...row, status: 'closed' as const };
-  });
-  if (changed) commit(centerId, { ...book, charges });
-}
-
-export function saveInvoiceTitle(centerId: string, title: InvoiceTitle) {
-  const book = sweep(bookOf(getStore(), centerId));
-  commit(centerId, { ...book, title });
-}
-
-/** Link whole paid charges to one issuing request. Unpaid rows are refused. */
-export function requestInvoice(
-  centerId: string,
-  chargeIds: string[],
-  title: InvoiceTitle,
-): boolean {
-  const book = sweep(bookOf(getStore(), centerId));
-  const wanted = new Set(chargeIds);
-  const selected = book.charges.filter(
-    (row) => wanted.has(row.id) && row.status === 'paid' && !row.invoiceId,
-  );
-  if (selected.length === 0 || selected.length !== wanted.size) return false;
-  const id = crypto.randomUUID();
-  const invoice: InvoiceRecord = {
-    id,
-    amount: selected.reduce((sum, row) => sum + row.amount, 0),
-    chargeIds: selected.map((row) => row.id),
-    ...title,
-    createdAt: Date.now(),
-    status: 'issuing',
-  };
-  const charges = book.charges.map((row) =>
-    wanted.has(row.id) ? { ...row, invoiceId: id } : row,
-  );
-  commit(centerId, {
-    ...book,
-    charges,
-    invoices: [invoice, ...book.invoices],
-    title,
-  });
-  return true;
-}
-
-export function useBillingBook(centerId: string) {
-  const store = useSyncExternalStore(subscribe, getStore, getStore);
-  return bookOf(store, centerId);
-}
