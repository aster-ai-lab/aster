-/** 立即执行一轮知识编译（测试与定时器共用；状态机守卫 compiling）。 */
-/** 立即执行一轮知识编译（测试与定时器共用；重复排队由 queueCompile 拒绝）。 */
-export function compileNowInScope(scope: string, baseId: string): CompilationRun | null {
-  const current = bucketOf(scope);
-  const base = current.bases.find((item) => item.id === baseId);
-  if (!base) return null;
-  // 执行器不设状态守卫：重复排队由 queueCompile 拒绝，这里总是可跑一轮（幂等）
-  const docs = current.docs.filter((doc) => doc.baseId === baseId && doc.status === 'parsed');
-  const generated: string[] = [];
-  const updated: string[] = [];
-  const skipped: string[] = [];
-  const maxEdition = current.wiki.reduce((m, page) => Math.max(m, page.edition ?? 0), 0);
-  const edition = maxEdition + 1;
-  let wiki = [...current.wiki];
-      for (const doc of docs) {
-        // 来源匹配：编译来源一致，或标题一致（同主题页刷新而非重建）；手改页已在上方跳过
-        const existing = wiki.find(
-          (page) =>
-            page.baseId === baseId &&
-            (page.sourceDocId === doc.id || (!page.manuallyEdited && page.title === wikiTitleFor(doc.name))),
-        );
-        if (existing?.manuallyEdited) {
-          skipped.push(doc.id); // 手改优先：手动编辑过的页不进管线（不变量 D）
-          continue;
-        }
-        if (existing) {
-          const prev = existing.body;
-          wiki = wiki.map((page) =>
-            page.id === existing.id
-              ? {
-                  ...page,
-                  body: doc.text,
-                  edition,
-                  compiledAt: now(),
-                  manuallyEdited: false,
-                  updatedAt: now(),
-                  revisions: prev === doc.text ? page.revisions : [{ at: now(), body: prev }, ...page.revisions].slice(0, 20),
-                }
-              : page,
-          );
-          updated.push(doc.id);
-        } else {
-          const row: WikiPage = {
-            id: nid(),
-            baseId,
-            title: wikiTitleFor(doc.name),
-            body: doc.text,
-            revisions: [],
-            updatedAt: now(),
-            compiledAt: now(),
-            edition,
-            sourceDocId: doc.id,
-          };
-          wiki = [row, ...wiki];
-          generated.push(doc.id);
-        }
-      }
-      const run: CompilationRun = {
-        id: nid(),
-        baseId,
-        at: now(),
-        generatedDocIds: generated,
-        updatedDocIds: updated,
-        skippedDocIds: skipped,
-      };
-      commit(scope, {
-        ...current,
-        wiki,
-        compilations: [run, ...current.compilations].slice(0, 10),
-        bases: current.bases.map((item) =>
-          item.id === baseId ? { ...item, compile: { state: 'compiled' as const, at: run.at } } : item,
-        ),
-      });
-      return run;
-}
