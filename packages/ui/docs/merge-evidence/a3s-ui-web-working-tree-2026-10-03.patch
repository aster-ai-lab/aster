-function bucketOf(scope: string): HubBucket {
-  const existing = file[scope];
-  if (existing) {
-    const normalized = migrateBucket(existing);
-    if (normalized !== existing) {
-      file = { ...file, [scope]: normalized };
-      persistQuiet();
-    }
-    return file[scope] ?? normalized;
-  }
-  const seeded = seedBucket();
-  file = { ...file, [scope]: seeded };
-  persistQuiet();
-  return seeded;
-}
