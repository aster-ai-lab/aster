-import { cn } from '@kense/ui';
-
-/**
- * 受控的 markdown 子集渲染：标题 / 段落 / 引用 / 列表 / 围栏代码 / 分隔线，
- * 行内 code、粗体、斜体、链接。全部输出 React 文本节点，不经 HTML 注入；
- * 链接只放行 http(s)、mailto、锚点与站内路径。
- */
-
-export type MdSpan =
-  | { kind: 'text' | 'code' | 'bold' | 'italic'; text: string }
-  | { kind: 'link'; text: string; href: string };
-
-export type MdBlock =
-  | { type: 'heading'; level: 1 | 2 | 3; spans: MdSpan[] }
-  | { type: 'paragraph' | 'quote'; spans: MdSpan[] }
-  | { type: 'list'; ordered: boolean; items: MdSpan[][] }
-  | { type: 'code'; text: string }
-  | { type: 'hr' };
-
-export function safeHref(href: string): string | null {
-  const trimmed = href.trim();
-  if (/^(https?:\/\/|mailto:|#|\/)/i.test(trimmed)) return trimmed;
-  return null;
-}
-
-export function parseInline(text: string): MdSpan[] {
-  const spans: MdSpan[] = [];
-  let plain = '';
-  const flush = () => {
-    if (plain) {
-      spans.push({ kind: 'text', text: plain });
-      plain = '';
-    }
-  };
-  let index = 0;
-  while (index < text.length) {
-    const rest = text.slice(index);
-    if (rest.startsWith('`')) {
-      const end = text.indexOf('`', index + 1);
-      if (end > index) {
-        flush();
-        spans.push({ kind: 'code', text: text.slice(index + 1, end) });
-        index = end + 1;
-        continue;
-      }
-    }
-    if (rest.startsWith('**')) {
-      const end = text.indexOf('**', index + 2);
-      if (end > index) {
-        flush();
-        spans.push({ kind: 'bold', text: text.slice(index + 2, end) });
-        index = end + 2;
-        continue;
-      }
-    }
-    if (rest.startsWith('*') && !rest.startsWith('**')) {
-      const end = text.indexOf('*', index + 1);
-      if (end > index) {
-        flush();
-        spans.push({ kind: 'italic', text: text.slice(index + 1, end) });
-        index = end + 1;
-        continue;
-      }
-    }
-    if (rest.startsWith('[')) {
-      const match = /^\[([^\]]+)\]\(([^)\s]+)\)/.exec(rest);
-      if (match) {
-        const href = safeHref(match[2] ?? '');
-        flush();
-        if (href) spans.push({ kind: 'link', text: match[1] ?? '', href });
-        else plain += match[1] ?? '';
-        index += match[0].length;
-        continue;
-      }
-    }
-    plain += text[index];
-    index += 1;
-  }
-  flush();
-  return spans;
-}
-
-export function parseMarkdown(text: string): MdBlock[] {
-  const lines = text.replace(/\r\n?/g, '\n').split('\n');
-  const blocks: MdBlock[] = [];
-  let paragraph: string[] = [];
-  const flushParagraph = () => {
-    if (paragraph.length > 0) {
-      blocks.push({ type: 'paragraph', spans: parseInline(paragraph.join(' ')) });
-      paragraph = [];
-    }
-  };
-  let index = 0;
-  while (index < lines.length) {
-    const line = lines[index] ?? '';
-    const fence = /^```/.exec(line);
-    if (fence) {
-      flushParagraph();
-      const body: string[] = [];
-      index += 1;
-      while (index < lines.length && !/^```/.test(lines[index] ?? '')) {
-        body.push(lines[index] ?? '');
-        index += 1;
-      }
-      index += 1;
-      blocks.push({ type: 'code', text: body.join('\n') });
-      continue;
-    }
-    const heading = /^(#{1,3})\s+(.*)$/.exec(line);
-    if (heading) {
-      flushParagraph();
-      blocks.push({
-        type: 'heading',
-        level: heading[1]!.length as 1 | 2 | 3,
-        spans: parseInline(heading[2] ?? ''),
-      });
-      index += 1;
-      continue;
-    }
-    if (/^(---+|\*\*\*+)\s*$/.test(line)) {
-      flushParagraph();
-      blocks.push({ type: 'hr' });
-      index += 1;
-      continue;
-    }
-    const quote = /^>\s?(.*)$/.exec(line);
-    if (quote) {
-      flushParagraph();
-      const body = [quote[1] ?? ''];
-      index += 1;
-      while (index < lines.length) {
-        const more = /^>\s?(.*)$/.exec(lines[index] ?? '');
-        if (!more) break;
-        body.push(more[1] ?? '');
-        index += 1;
-      }
-      blocks.push({ type: 'quote', spans: parseInline(body.join(' ')) });
-      continue;
-    }
-    const bullet = /^[-*]\s+(.*)$/.exec(line);
-    const ordered = /^\d+[.、]\s+(.*)$/.exec(line);
-    if (bullet || ordered) {
-      flushParagraph();
-      const isOrdered = Boolean(ordered);
-      const marker = isOrdered ? ordered : bullet;
-      const items: MdSpan[][] = [parseInline(marker?.[1] ?? '')];
-      index += 1;
-      while (index < lines.length) {
-        const more = isOrdered
-          ? /^\d+[.、]\s+(.*)$/.exec(lines[index] ?? '')
-          : /^[-*]\s+(.*)$/.exec(lines[index] ?? '');
-        if (!more) break;
-        items.push(parseInline(more[1] ?? ''));
-        index += 1;
-      }
-      blocks.push({ type: 'list', ordered: isOrdered, items });
-      continue;
-    }
-    if (!line.trim()) {
-      flushParagraph();
-      index += 1;
-      continue;
-    }
-    paragraph.push(line.trim());
-    index += 1;
-  }
-  flushParagraph();
-  return blocks;
-}
-
-function InlineSpans({ spans }: { spans: MdSpan[] }) {
-  return (
-    <>
-      {spans.map((span, index) => {
-        if (span.kind === 'code') return <code key={index}>{span.text}</code>;
-        if (span.kind === 'bold') return <strong key={index}>{span.text}</strong>;
-        if (span.kind === 'italic') return <em key={index}>{span.text}</em>;
-        if (span.kind === 'link') {
-          return (
-            <a key={index} href={span.href} target="_blank" rel="noreferrer">
-              {span.text}
-            </a>
-          );
-        }
-        return <span key={index}>{span.text}</span>;
-      })}
-    </>
-  );
-}
-
-export function MarkdownView({ text, className }: { text: string; className?: string }) {
-  const blocks = parseMarkdown(text);
-  return (
-    <div className={cn('os-hub-md', className)}>
-      {blocks.map((block, index) => {
-        if (block.type === 'hr') return <hr key={index} />;
-        if (block.type === 'code') {
-          return (
-            <pre key={index}>
-              <code>{block.text}</code>
-            </pre>
-          );
-        }
-        if (block.type === 'heading') {
-          const Tag = (`h${Math.min(block.level + 1, 4)}`) as 'h2' | 'h3' | 'h4';
-          return <Tag key={index}><InlineSpans spans={block.spans} /></Tag>;
-        }
-        if (block.type === 'list') {
-          const rows = block.items.map((item, itemIndex) => (
-            <li key={itemIndex}><InlineSpans spans={item} /></li>
-          ));
-          return block.ordered ? <ol key={index}>{rows}</ol> : <ul key={index}>{rows}</ul>;
-        }
-        if (block.type === 'quote') {
-          return <blockquote key={index}><InlineSpans spans={block.spans} /></blockquote>;
-        }
-        return <p key={index}><InlineSpans spans={block.spans} /></p>;
-      })}
-    </div>
-  );
-}
