-async function orgRequest<T>(
-  path: string,
-  init?: RequestInit & { auth?: boolean },
-): Promise<T> {
-  const { auth = true, headers, ...rest } = init ?? {};
-  const token = auth ? getOrgMemberToken() : null;
-  const response = await fetch(`${ORG_API_BASE}${path}`, {
-    cache: 'no-store',
-    ...rest,
-    headers: {
-      Accept: 'application/json',
-      'content-type': 'application/json',
-      ...(headers as Record<string, string> | undefined),
-      ...(token ? { authorization: `Bearer ${token}` } : {}),
-    },
-  });
-  const text = await response.text();
-  let payload: unknown = null;
-  if (text) {
-    try {
-      payload = JSON.parse(text);
-    } catch {
-      throw new Error(text || `HTTP ${response.status}`);
-    }
-  }
-  try {
-    return unwrapApiEnvelope<T>(payload, response.status);
-  } catch (err) {
-    if (
-      token &&
-      response.status === 401 &&
-      err instanceof Error &&
-      err.name === 'ApiRequestError'
-    ) {
-      setOrgMemberToken(null);
-    }
-    throw err;
-  }
-}
