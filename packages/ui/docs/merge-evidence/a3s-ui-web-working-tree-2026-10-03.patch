-function formatClock(iso: string, locale: string) {
-  const date = new Date(iso);
-  if (Number.isNaN(date.getTime())) return iso;
-  return new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
-    hour: '2-digit',
-    minute: '2-digit',
-    second: '2-digit',
-    hour12: false,
-  }).format(date);
-}
-
-function formatUpdated(iso: string, locale: string) {
-  const date = new Date(iso);
-  if (Number.isNaN(date.getTime())) return { relative: iso, absolute: iso };
-  const absolute = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-US', {
-    year: 'numeric',
-    month: '2-digit',
-    day: '2-digit',
-    hour: '2-digit',
-    minute: '2-digit',
-    hour12: false,
-  }).format(date);
-  const deltaSec = Math.round((Date.now() - date.getTime()) / 1000);
-  if (deltaSec < 0) return { relative: absolute, absolute };
-  const zh = locale === 'zh';
-  let relative = absolute;
-  if (deltaSec < 45) relative = zh ? '刚刚' : 'just now';
-  else if (deltaSec < 3600) {
-    const minutes = Math.max(1, Math.round(deltaSec / 60));
-    relative = zh ? `${minutes} 分钟前` : `${minutes}m ago`;
-  } else if (deltaSec < 86400) {
-    const hours = Math.max(1, Math.round(deltaSec / 3600));
-    relative = zh ? `${hours} 小时前` : `${hours}h ago`;
-  } else if (deltaSec < 86400 * 7) {
-    const days = Math.max(1, Math.round(deltaSec / 86400));
-    relative = zh ? `${days} 天前` : `${days}d ago`;
-  }
-  return { relative, absolute };
-}
