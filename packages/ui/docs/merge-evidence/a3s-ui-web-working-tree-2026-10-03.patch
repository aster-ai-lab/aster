-/** pending → 排队模拟：先转「解析中」，随后得出解析结论。 */
-function scheduleParse(scope: string, id: string) {
-  if (typeof window === 'undefined') return; // 非浏览器环境（单测）由 runParseNow 直接驱动
-  pushParseTimer(
-    scope,
-    id,
-    setTimeout(() => {
-      patchDocStatus(scope, id, { status: 'parsing' });
-      pushParseTimer(
-        scope,
-        id,
-        setTimeout(() => runParseNow(scope, id), 500 + Math.random() * 500),
-      );
-    }, 600 + Math.random() * 600),
-  );
-}
