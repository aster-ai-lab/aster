-function patchDocStatus(scope: string, id: string, patch: Partial<HubDocument> & { status?: DocStatus }) {
-  const current = bucketOf(scope);
-  const doc = current.docs.find((item) => item.id === id);
-  if (!doc) return null;
-  if (doc.status !== 'pending' && doc.status !== 'parsing') return null; // 状态机守卫：非法迁移忽略
-  const next = { ...doc, ...patch };
-  commit(scope, { ...current, docs: current.docs.map((item) => (item.id === id ? next : item)) });
-  return next;
-}
