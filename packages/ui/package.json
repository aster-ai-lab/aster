{
  "name": "@a3s-lab/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A3S UI Component Library — shadcn-based React components shared by the a3s console and studio",
  "license": "MIT",
  "sideEffects": [
    "**/*.css",
    "./src/components/composites/markdown/styles.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./components/composites/code-editor": "./src/components/composites/code-editor/index.ts",
    "./components/primitives/portal-container": "./src/components/primitives/portal-container.tsx",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/*": "./src/lib/*",
    "./icons": "./src/components/icons/index.ts",
    "./icons/providers": "./src/components/icons/providers/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/theme.css": "./src/styles/theme.css",
    "./styles/dialog-motion.css": "./src/styles/dialog-motion.css",
    "./styles/popup-motion.css": "./src/styles/popup-motion.css",
    "./styles/row-motion.css": "./src/styles/row-motion.css",
    "./styles/components.css": "./src/styles/components.css",
    "./styles.css": "./src/styles-legacy-compat.css",
    "./rsbuild": "./rsbuild.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun -e \"console.log('@a3s-lab/ui is source-exported')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "theme:build": "bun scripts/build-theme-css.ts",
    "theme:check": "bun scripts/check-theme-contract.ts",
    "icons:generate": "bun scripts/icons-generate.ts",
    "icons:validate": "bun scripts/icons-validate.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
