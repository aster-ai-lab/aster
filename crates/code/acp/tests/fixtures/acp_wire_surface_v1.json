      "aster/workspace/search/v1",
      "aster/memory/manage",
      "aster/memory/snapshot",
      "aster/memory/flush",
      "aster/memory/dream",
      "aster/session/info",
      "aster/session/list",
      "aster/session/delete",
      "aster/permission_posture",
      "aster/session/transcript/page/v1",
      "aster/session/fork/prefix/v1",
      "aster/session/tooling/v1",
