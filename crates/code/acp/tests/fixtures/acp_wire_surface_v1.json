  "executionObserve": {
    "codeConst": "_aster/execution/observe",
    "note": "the const already carries the extension underscore; the ACP SDK adds another on the wire"
  },
  "queueChanged": {
    "wireMethod": "_aster/queue/changed",
    "paramsKeys": ["runningKind", "runningPromptId", "runningText", "sessionId"],
    "runningKind": "prompt",
    "precedes": "the turn's first model output update (agent_message_chunk, agent_thought_chunk or tool_call); mode and command updates may come earlier"
  },
  "turnQueue": {
    "order": "fifo per session; one running turn",
    "cancelTarget": "the running turn only; a queued prompt survives and starts next",
    "promptResponseEchoes": "_meta.promptId"
  }
}
