# syntax=docker/dockerfile:1.7

FROM ubuntu@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316

RUN DEBIAN_FRONTEND=noninteractive apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 65532 aster \
    && useradd --uid 65532 --gid 65532 --home-dir /workspace --no-create-home \
        --shell /usr/sbin/nologin aster \
    && install --directory --owner=aster --group=aster /app /app/.aster /workspace /run/secrets

COPY --chmod=0755 aster /usr/bin/aster
COPY --chown=65532:65532 config.acl /app/config.acl
RUN /usr/bin/aster --version >/dev/null

USER 65532:65532
RUN printf 'Aster Agent release workspace\n' > /workspace/.aster-release-seed \
    && git -C /workspace init --initial-branch=main \
    && git -C /workspace config user.name 'Aster Release Fixture' \
    && git -C /workspace config user.email 'release-fixture@aster.invalid' \
    && git -C /workspace add .aster-release-seed \
    && GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' \
       GIT_COMMITTER_DATE='2000-01-01T00:00:00Z' \
       git -C /workspace commit --message 'Initialize Agent workspace'

WORKDIR /workspace
ENV ASTER_CONFIG_FILE=/app/config.acl \
    ASTER_NON_INTERACTIVE=1 \
    ASTER_NO_PROGRESS=1
STOPSIGNAL SIGTERM

# The final manifest is deliberately absent. The runtime injects it only after
# this image has an immutable OCI manifest digest.
ENTRYPOINT ["/usr/bin/aster", "code", "harness", "--manifest", "/app/.aster/asset.acl"]
