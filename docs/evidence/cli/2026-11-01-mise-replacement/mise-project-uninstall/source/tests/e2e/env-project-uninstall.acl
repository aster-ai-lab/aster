suite "env-project-uninstall" {
  version = 1

  scenario "01-decline-project-removal" {
    surface = "tui"
    timeout_ms = 30000

    wait "project-selection" {
      text = "uv@0.13.6 requested by"
    }
    wait "confirmation" {
      text = "[y/N]"
    }
    press "decline" {
      key = "n"
    }
    press "submit" {
      key = "Enter"
    }
    wait "cancelled" {
      text = "Cancelled."
    }
    terminal_recording "decline-evidence" {
      path = "terminal/decline.vt"
    }
  }

  scenario "02-confirm-project-removal" {
    surface = "tui"
    timeout_ms = 30000

    wait "project-selection" {
      text = "uv@0.13.6 requested by"
    }
    wait "confirmation" {
      text = "[y/N]"
    }
    press "confirm" {
      key = "y"
    }
    press "submit" {
      key = "Enter"
    }
    wait "removed" {
      text = "Removed uv@0.13.6."
    }
    terminal_recording "confirm-evidence" {
      path = "terminal/confirm.vt"
    }
  }
}
