+    tui.bytes(b"\\\r");
+    tui.pump(200);
+    assert_not_submitted(&tui);
+    tui.record(
+        "backslash-enter-newline",
+        "backslash then Enter keeps the draft local",
+    );
+    tui.bytes(lines[2].as_bytes());
