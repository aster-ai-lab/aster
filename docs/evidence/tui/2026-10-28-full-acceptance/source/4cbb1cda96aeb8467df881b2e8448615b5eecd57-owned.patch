+    let lines = [
+        "Do not call tools. Reply exactly ALT-BACKSLASH-OK.",
+        "ALT 行：中文 λ e\u{301}.",
+        "BACKSLASH 行：左右 \\ / <> &.",
+    ];
+    tui.bytes(lines[0].as_bytes());
+    tui.wait_for(lines[0], 8);
+    tui.bytes(b"\x1b\r");
+    tui.pump(200);
+    assert_not_submitted(&tui);
+    tui.record(
+        "alt-enter-newline",
+        "Alt+Enter in normal mode keeps the draft local",
+    );
