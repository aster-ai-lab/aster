+        .iter()
+        .filter(|fact| fact["type"] == "user.message")
+        .count();
+    assert_eq!(turns, 2);
+    tui.command("/session-info");
+    let backend = tui.acp_session_info(&id, 2);
+    assert_eq!(backend["permissionPosture"].as_str(), Some("yolo"));
