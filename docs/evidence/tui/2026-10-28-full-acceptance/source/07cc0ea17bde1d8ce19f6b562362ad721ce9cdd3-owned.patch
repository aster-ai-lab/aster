+    );
+    tui.bytes(if cfg!(windows) { b"\n" } else { b"\x1b[13;5u" });
+    let deadline = Instant::now() + Duration::from_secs(420);
+    let observed = loop {
+        let screen = tui.pump(80);
+        assert!(
+            !screen.contains("Turn failed") && !screen.contains("Send now failed"),
+            "model-stream send-now failed\n{screen}"
+        );
+        let facts = tui.facts();
+        let delta = facts.get(before..).unwrap_or_default();
+        if delta.iter().any(|fact| fact["type"] == "turn.complete")
+            && tui.assistant_text(delta).contains("MODEL-CANCEL-NEXT")
+            && !screen.contains("[stop]")
+            && !screen.contains("Ctrl+c:cancel")
+        {
+            break delta.to_vec();
+        }
+        assert!(
+            Instant::now() < deadline,
+            "model-stream send-now did not settle\n{screen}"
+        );
+    };
+    let messages = observed
+        .iter()
+        .filter(|fact| fact["type"] == "user.message")
+        .map(|fact| fact["payload"]["text"].as_str().unwrap())
+        .collect::<Vec<_>>();
+    assert_eq!(messages, vec![initial, followup]);
+    assert!(!observed.iter().any(|fact| fact["type"] == "tool.prepared"));
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|fact| fact["type"] == "turn.complete")
+            .count(),
+        1
+    );
+    tui.record("send-now-model-owner", "an actual partial Kimi response is cancelled; the next exact message completes once in the same session without tools");
+    tui.quit();
+    tui.finish();
+}
diff --git a/crates/code/core/src/tools/exit_code_tests.rs b/crates/code/core/src/tools/exit_code_tests.rs
