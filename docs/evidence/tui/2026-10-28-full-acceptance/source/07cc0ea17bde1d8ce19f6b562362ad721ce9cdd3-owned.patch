+#[test]
+#[ignore = "requires the paired source build and original kimi/k3.1-pro ACL"]
+fn kimi_send_now_interrupts_model_stream_and_completes_next_prompt_once() {
+    let mut tui = LiveTui::new("send-now-model-stream");
+    tui.launch_default(&[]);
