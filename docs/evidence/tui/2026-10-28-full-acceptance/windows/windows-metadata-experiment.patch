+fn security_descriptor(file: &impl AsRawHandle) -> Option<Vec<u8>> {
+    const MAX_DESCRIPTOR_BYTES: u32 = 64 * 1024;
+    const INFORMATION: u32 =
+        OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION;
+    let mut needed = 0;
+    // SAFETY: the live handle and length output are valid; a null zero-length
+    // buffer queries the required size without reading an object by path.
+    let queried = unsafe {
+        GetKernelObjectSecurity(
+            file.as_raw_handle(),
+            INFORMATION,
+            std::ptr::null_mut(),
+            0,
+            &mut needed,
+        )
+    };
+    if queried != 0
+        || unsafe { GetLastError() } != ERROR_INSUFFICIENT_BUFFER
+        || needed == 0
+        || needed > MAX_DESCRIPTOR_BYTES
+    {
+        return None;
+    }
+    // Security descriptors require four-byte alignment. The API returns a
+    // self-relative descriptor, so its bytes contain offsets, not pointers.
+    let mut words = vec![0_u32; (needed as usize).div_ceil(4)];
+    let capacity = (words.len() * std::mem::size_of::<u32>()) as u32;
+    // SAFETY: the aligned buffer owns capacity writable bytes. Failure,
+    // including a descriptor that grew after the size query, is refused.
+    if unsafe {
+        GetKernelObjectSecurity(
+            file.as_raw_handle(),
+            INFORMATION,
+            words.as_mut_ptr().cast(),
+            capacity,
+            &mut needed,
+        )
+    } == 0
+        || needed > capacity
+    {
+        return None;
+    }
+    // SAFETY: a successful call initialized needed bytes within the buffer.
+    Some(
+        unsafe { std::slice::from_raw_parts(words.as_ptr().cast::<u8>(), needed as usize) }
+            .to_vec(),
+    )
+}
