+#[test]
+fn windows_observation_keeps_real_security_and_link_changes() {
+    let root = tempfile::tempdir().unwrap();
+    let file = root.path().join("proof.txt");
+    std::fs::write(&file, "unchanged bytes").unwrap();
+    let before = observe_identity_windows(root.path(), "proof.txt", &mut 1024, false).unwrap();
+    let script = root.path().join("protect.ps1");
+    std::fs::write(&script, "$ErrorActionPreference = 'Stop'\n$p = Join-Path $PSScriptRoot 'proof.txt'\n$a = Get-Acl -LiteralPath $p\n$sid = [System.Security.Principal.SecurityIdentifier]::new('S-1-1-0')\n$rule = [System.Security.AccessControl.FileSystemAccessRule]::new($sid, [System.Security.AccessControl.FileSystemRights]::ReadData, [System.Security.AccessControl.AccessControlType]::Allow)\n$a.AddAccessRule($rule)\nSet-Acl -LiteralPath $p -AclObject $a\n").unwrap();
+    let shell = std::path::PathBuf::from(std::env::var_os("SystemRoot").unwrap())
+        .join("System32/WindowsPowerShell/v1.0/powershell.exe");
+    let output = std::process::Command::new(shell)
+        .args(["-NoProfile", "-NonInteractive", "-File"])
+        .arg(&script)
+        .output()
+        .unwrap();
+    assert!(output.status.success(), "{:?}", output.stderr);
+    let secured = observe_identity_windows(root.path(), "proof.txt", &mut 1024, false).unwrap();
+    assert_eq!(before.content_digest, secured.content_digest);
+    assert_eq!(before.modified, secured.modified);
+    assert_ne!(before.metadata_digest, secured.metadata_digest);
+    std::fs::hard_link(&file, root.path().join("link.txt")).unwrap();
+    let linked = observe_identity_windows(root.path(), "proof.txt", &mut 1024, false).unwrap();
+    assert_eq!(secured.content_digest, linked.content_digest);
+    assert_eq!(secured.modified, linked.modified);
+    assert_ne!(secured.metadata_digest, linked.metadata_digest);
+}
