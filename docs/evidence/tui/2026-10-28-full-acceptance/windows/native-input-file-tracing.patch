+#[cfg(windows)]
+fn input_diagnostic(phase: &str, count: usize, extra: usize) {
+    use std::io::Write;
+    let Some(home) = std::env::var_os("GROK_HOME") else {
+        return;
+    };
+    let path = std::path::PathBuf::from(home).join("input-diagnostic.log");
+    if let Ok(mut file) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(path)
+    {
+        let now = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_millis();
+        let _ = writeln!(file, "{now} {phase} {count} {extra}");
+    }
+}
