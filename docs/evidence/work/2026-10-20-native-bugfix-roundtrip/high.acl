suite "terminal-high-budget" {
  version = 1
  scenario "real-sidecar-default" {
    surface = "tui"
    timeout_ms = 45000
    wait "connected" { regex = "(?i)high" }
    terminal_paste "prompt" { text = "BUGFIX_TERMINAL_EFFORT" }
    press "send" { key = "Enter" }
    wait "reply" { text = "E2E old gpt-4.1-mini" }
    terminal_recording "native-sidecar" { path = "terminal/high.vt" }
  }
}
