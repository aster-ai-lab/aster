+        assert!(record["lastError"].as_str().unwrap().contains("needs_input"), "{record}");
+        assert!(record["durationMs"].as_u64() < Some(10_000), "{record}");
+        eprintln!("STALLED_GOAL_RESULT {record}");
+    }).await;
