+        && effects.changes.iter().any(|change| {
+            if crate::porcelain::is_harness_path(&change.path) {
+                return false;
+            }
+            let Some(before) = &change.before else {
+                return false;
+            };
+            before.kind != change.after.kind
+                || (matches!(before.kind, ToolFileKind::File | ToolFileKind::Symlink)
