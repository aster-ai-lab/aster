+    let first = std::sync::Arc::new(LazyFileMemoryStore::new(&memory_dir));
+    let legacy_items = memory_dir.join("items");
+    std::fs::create_dir_all(&legacy_items).unwrap();
+    let legacy = MemoryItem::new("legacy atomic import fact");
+    std::fs::write(
