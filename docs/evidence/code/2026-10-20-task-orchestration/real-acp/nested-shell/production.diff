+    pub(crate) fn record_nested_shell_verification(
+        &mut self,
+        command: &str,
+        epoch: u64,
+        workspace: &std::path::Path,
+    ) {
+        if !self.nested_mutation_window_is_current(epoch)
+            || self.observation_incomplete
