     fn requests(&self) -> Vec<Value> {
         self.requests.lock().unwrap().clone()
     }
+
+    fn read_request(socket: &mut std::net::TcpStream) -> Result<Value, String> {
+        // Darwin's accept inherits O_NONBLOCK from the listener. The listener
+        // polls for shutdown, but each HTTP connection uses bounded blocking I/O.
+        socket
+            .set_nonblocking(false)
+            .map_err(|error| format!("provider socket blocking mode: {error}"))?;
+        socket
+            .set_read_timeout(Some(Duration::from_secs(5)))
+            .map_err(|error| format!("provider socket read timeout: {error}"))?;
+        socket
+            .set_write_timeout(Some(Duration::from_secs(5)))
+            .map_err(|error| format!("provider socket write timeout: {error}"))?;
+        let mut bytes = Vec::new();
+        let mut chunk = [0; 8192];
+        loop {
+            let count = socket.read(&mut chunk).map_err(|error| {
+                format!(
+                    "provider request read: {:?}, received {} bytes: {error}",
+                    error.kind(),
+                    bytes.len()
+                )
+            })?;
+            if count == 0 {
+                return Err(format!("provider request EOF after {} bytes", bytes.len()));
+            }
+            if bytes.len() + count > 2 * 1024 * 1024 {
+                return Err("provider request exceeds 2 MiB".into());
+            }
+            bytes.extend_from_slice(&chunk[..count]);
+            let Some(end) = bytes.windows(4).position(|part| part == b"\r\n\r\n") else {
+                continue;
+            };
+            let header = String::from_utf8_lossy(&bytes[..end]);
+            if !header.starts_with("POST /v1/chat/completions ") {
+                return Err("unexpected provider HTTP request line".into());
+            }
+            let length = header
+                .lines()
+                .find_map(|line| {
+                    line.to_ascii_lowercase()
+                        .strip_prefix("content-length:")
+                        .and_then(|length| length.trim().parse::<usize>().ok())
+                })
+                .ok_or("provider request has no Content-Length")?;
+            if bytes.len() >= end + 4 + length {
+                return serde_json::from_slice(&bytes[end + 4..end + 4 + length])
+                    .map_err(|error| error.to_string());
+            }
+        }
+    }
