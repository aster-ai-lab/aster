                  },
                  "path": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  },
                  "size": {
                    "format": "uint64",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "path",
                  "media_type",
                  "size",
                  "sha256"
                ],
                "type": "object"
              },
