                      },
                      {
                        "const": null,
                        "nullable": true
                      }
                    ]
                  },
                  "confidence": {
                    "description": "Provider recognition confidence from 0 through 1, when available",
                    "format": "float",
                    "nullable": true,
                    "type": "number"
                  },
                  "detectionConfidence": {
                    "description": "Provider text-detection confidence from 0 through 1, when available",
                    "format": "float",
                    "nullable": true,
                    "type": "number"
                  },
                  "page": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "polygon": {
                    "description": "Four polygon vertices in source-image coordinates, when available",
                    "items": {
                      "$ref": "#/definitions/OcrPoint"
                    },
                    "maxItems": 4,
                    "minItems": 4,
                    "nullable": true,
                    "type": "array"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "page",
                  "text"
                ],
                "type": "object"
              },
              "OcrBoundingBox": {
                "properties": {
                  "height": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "width": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "x": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "type": "object"
              },
              "OcrPoint": {
                "properties": {
                  "x": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "y": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": "object"
              }
            },
            "properties": {
              "blocks": {
                "items": {
                  "$ref": "#/definitions/OcrBlock"
                },
                "type": "array"
              },
              "engine": {
                "type": "string"
              },
              "model": {
                "nullable": true,
                "type": "string"
              },
              "provider": {
                "type": "string"
              },
              "source": {
                "$ref": "#/definitions/OcrArtifactSchema"
              },
              "text": {
                "type": "string"
              },
              "warnings": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "provider",
              "engine",
              "source",
              "text"
            ],
            "title": "OcrResult",
            "type": "object"
          },
          "annotations": {
            "readOnlyHint": true,
            "destructiveHint": false,
            "idempotentHint": true,
            "openWorldHint": false
          }
        }
