{
  "action_ownership": {
    "deterministic_runner": [
      "verify_contract"
    ],
    "interactive": "actions listed in action_schema"
  },
  "action_schema": {
    "$defs": {
      "CaptureOperation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "start",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "type": {
                "const": "stop",
                "type": "string"
              }
            },
            "required": [
              "type",
              "path"
            ],
            "type": "object"
          }
        ]
      },
      "DialogOperation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "status",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "type": {
                "const": "accept",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "dismiss",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "ElementState": {
        "enum": [
          "enabled",
          "checked",
          "selected",
          "focused",
          "focus_within",
          "expanded",
          "pressed",
          "readonly",
          "required",
          "invalid"
        ],
        "type": "string"
      },
      "Expectation": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text_visible",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "url",
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "visible",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "in_viewport",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "viewport_coverage",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "comparison": {
                    "$ref": "#/$defs/ViewportCoverageComparison"
                  },
                  "percent": {
                    "format": "uint8",
                    "maximum": 100,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "target": {
                    "$ref": "#/$defs/Target"
                  }
                },
                "required": [
                  "target",
                  "comparison",
                  "percent"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "pointer_reachable",
                "type": "string"
              },
              "value": {
                "$ref": "#/$defs/Target"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "rendered_text",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "target",
                  "value"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "rendered_texts",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "values": {
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 256,
                    "type": "array"
                  }
                },
                "required": [
                  "target",
                  "values"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "visible_count",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "target": {
                    "$ref": "#/$defs/Target"
                  }
                },
                "required": [
                  "target",
                  "count"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "state",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "expected": {
                    "type": "boolean"
                  },
                  "state": {
                    "$ref": "#/$defs/ElementState"
                  },
                  "target": {
                    "$ref": "#/$defs/Target"
                  }
                },
                "required": [
                  "target",
                  "state",
                  "expected"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "value",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "value": {
                    "type": "string"
                  }
                },
                "required": [
                  "target",
                  "value"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "selected_values",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "values": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "target",
                  "values"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "layout",
                "type": "string"
              },
              "value": {
                "additionalProperties": false,
                "properties": {
                  "relation": {
                    "$ref": "#/$defs/LayoutRelation"
                  },
                  "relative_to": {
                    "$ref": "#/$defs/Target"
                  },
                  "target": {
                    "$ref": "#/$defs/Target"
                  },
                  "tolerance_px": {
                    "format": "uint32",
                    "maximum": 1024,
                    "minimum": 0,
                    "type": "integer"
                  }
                },
                "required": [
                  "target",
                  "relative_to",
                  "relation",
                  "tolerance_px"
                ],
                "type": "object"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "FrameTarget": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "main",
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "type": {
