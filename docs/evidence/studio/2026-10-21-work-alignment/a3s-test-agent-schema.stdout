              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "Target": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "ref",
                "type": "string"
              },
              "value": {
