              "value": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "value"
            ],
            "type": "object"
          }
        ]
      },
      "LayoutRelation": {
        "enum": [
          "above",
          "below",
          "left_of",
          "right_of",
          "contains",
          "inside",
          "overlaps",
