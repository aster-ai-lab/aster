e":{"const":"template"},"name":{"const":"program_code_search"},"inputs":{"type":"object","additionalProperties":false,"properties":{"query":{"description":"Regex or literal pattern to search for."},"path":{"description":"Workspace-relative path to search.","default":"."},"glob":{"description":"Optional file glob filter.","default":"*"}},"required":["query"]}},"required":["type","name","inputs"]},{"properties":{"type":{"const":"template"},"name":{"const":"program_repo_map"},"inputs":{"type":"object","additionalProperties":false,"properties":{"path":{"description":"Workspace-relative path to map.","default":"."}},"required":[]}},"required":["type","name"]}]},"strict":false},{"type":"function","name":"read","description":"Read text/images or batch 1-32 text files under one output budget. Returns line numbers and exact continuations. Lines over 2000 bytes are cut; use the returned byte_offset to resume.","parameters":{"type":"object","additionalProperties":false,"properties":{"file_path":{"type":"string","description":"Absolute/workspace-relative file or aster://tool-output/... URI from a tool result. Choose file_path or files."},"offset":{"type":"integer","minimum":0,"description":"0-based start line; default 0."},"byte_offset":{"type":"integer","minimum":0,"description":"Byte index in the first returned line only (default 0, at most its length); later lines are whole. Resume with the returned line offset and byte_offset."},"limit":{"type":"integer","minimum":1,"maximum":2000,"description":"Line limit; default/max 2000."},"files":{"type":"array","minItems":1,"maxItems":32,"description":"Text ranges in request order, sharing one output budget. Per-member errors preserve successful members.","items":{"type":"object","additionalProperties":false,"properties":{"path":{"type":"string","minLength":1,"maxLength":4096,"description":"Absolute/workspace-relative text file."},"offset":{"type":"integer","minimum":0,"description":"0-based start line; default 0."},"byte_offset":{"type":"integer","minimum":0,"description":"Byte index in this entry's first returned line; default 0, at most its length."},"limit":{"type":"integer","minimum":1,"maximum":2000,"description":"Line limit for this file; default/max 2000."}},"required":["path"]}},"max_output_bytes":{"type":"integer","minimum":1024,"maximum":98304,"description":"Shared batch byte budget, including continuation; default 65536, max 98304."}},"examples":[{"file_path":"src/main.rs"},{"file_path":"src/main.rs","offset":40,"limit":80},{"files":[{"path":"src/lib.rs"},{"path":"src/config.rs","offset":20,"limit":60}]}]},"strict":false},{"type":"function","name":"search","description":"Search the workspace with one model-selected mode. Use grep for an exact string or regex, glob for file names, bm25 for ranked lexical matches, semantic for concept similarity, hybrid to fuse available evidence channels.","parameters":{"type":"object","additionalProperties":false,"properties":{"mode":{"type":"string","enum":["grep","glob","bm25","semantic","hybrid"],"description":"Select a listed mode; bm25 may automatically use the durable local index."},"query":{"type":"string","minLength":1,"description":"Query for the selected mode."},"path":{"type":"string","description":"Workspace-relative directory/file, or aster://tool-output/... URI (grep only); default workspace root."},"include":{"type":"string","description":"Candidate-file glob, e.g. '*.rs' or '*.{ts,tsx}'."},"context":{"type":"integer","minimum":0,"description":"grep/bm25 context lines; BM25 default 2, max 8."},"case_sensitive":{"type":"boolean","description":"grep case sensitivity; default true."},"output_mode":{"type":"string","enum":["content","files_with_matches","count","summary"],"description":"grep: content (default) pages matches with context; files_with_matches/count page files; summary returns totals."},"limit":{"type":"integer","minimum":1,"maximum":1000,"description":"grep content matches with context, or glob/grep files/count files: default