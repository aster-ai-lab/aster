+#[tokio::test]
+async fn sse_handles_fragmented_utf8_crlf_and_explicit_done() {
+    let mut bytes = chunks(
+        "data: {\"text\":\"你好\"}\r\n\r\ndata: [DONE]\r\n\r\n".as_bytes(),
+        1,
+    );
+    let mut buffer = Vec::new();
+    let event = next_sse_event(&mut bytes, &mut buffer)
+        .await
