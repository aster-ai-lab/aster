+use super::*;
+
+fn chunks(bytes: &[u8], width: usize) -> impl Stream<Item = reqwest::Result<Vec<u8>>> + Unpin {
+    futures::stream::iter(
+        bytes
+            .chunks(width)
+            .map(|part| Ok(part.to_vec()))
+            .collect::<Vec<_>>(),
