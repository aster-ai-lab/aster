{
  "identifier": "main-capability",
  "description": "Loopback shell window. The page origin is http://127.0.0.1:<ephemeral>/, so child webviews are allowed only from that remote origin.",
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["main"],
  "webviews": ["main", "studio-embed", "studio-notice"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-log-to-host",
    "allow-message-attention",
    "allow-set-window-drag-regions",
    "allow-set-main-traffic-lights-hidden",
    "allow-open-workbench-applet-window",
    "allow-office-tool",
    "allow-data-sqlite-query",
    "allow-stage-pdf-tool-handoff",
    "allow-handle-document-result-save",
    "allow-open-file-editor-window",
    "allow-open-agent-wiki-window",
    "allow-open-aix-applet-window",
    "allow-read-aix-applet-home-deck",
    "allow-compile-personal-okf",
    "allow-open-mail-compose-window",
    "allow-open-notice-window",
    "allow-workspace-terminal",
    "allow-code-git",
    "allow-launch-workspace-browser",
    "allow-launch-notice-browser",
    "allow-quark-search-suggestions",
    "allow-binary-tools",
    "allow-workspace-browser-navigate",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:webview:allow-set-webview-zoom",
    "core:webview:allow-create-webview",
    "core:webview:allow-webview-close",
    "core:webview:allow-webview-hide",
    "core:webview:allow-webview-show",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-focus"
  ]
}
