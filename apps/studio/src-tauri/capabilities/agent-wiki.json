{
  "identifier": "agent-wiki-capability",
  "description": "Agent encyclopedia windows. Only minimize, zoom, close, and dragging.",
  "local": true,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "windows": ["agent-wiki-*"],
  "webviews": ["agent-wiki-*"],
  "permissions": [
    "allow-log-to-host",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
