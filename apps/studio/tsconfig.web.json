{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "sourceMap": false,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "composite": true,
    "incremental": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "paths": {
      "@cherrystudio/ai-core": ["./packages/aiCore/src/index.ts"],
      "@cherrystudio/ai-core/*": ["./packages/aiCore/src/*"],
      "@cherrystudio/ai-core/built-in/plugins": ["./packages/aiCore/src/core/plugins/built-in/index.ts"],
      "@cherrystudio/ai-core/provider": ["./packages/aiCore/src/core/providers/index.ts"],
      "@cherrystudio/ai-sdk-provider": ["./packages/ai-sdk-provider/src/index.ts"],
      "@cherrystudio/extension-table-plus": ["./packages/extension-table-plus/src/index.ts"],
      "@cherrystudio/provider-registry": ["./packages/provider-registry/src/index.ts"],
      "@a3s-lab/office/react": ["../../packages/office/dist/react.d.ts"],
      "@a3s-lab/office/core": ["../../packages/office/dist/core.d.ts"],
      "@a3s-lab/office": ["../../packages/office/dist/index.d.ts"],
      "@a3s-lab/intelligent-ui/openui": ["../../packages/intelligent-ui/src/openui.ts"],
      "@a3s-lab/intelligent-ui": ["../../packages/intelligent-ui/src/IntelligentUI.tsx"],
      "@a3s-lab/flow-ui/workflow-node-preview": [
        "../../crates/flow/packages/ui/src/react/workflow-node-preview.tsx"
      ],
      "@a3s-lab/ui/icons/providers": ["./packages/ui/src/components/icons/providers/index.ts"],
      "@a3s-lab/ui/icons": ["./packages/ui/src/components/icons/index.ts"],
      "@a3s-lab/ui": ["./packages/ui/src/index.ts"],
      "@a3s-lab/ui/*": ["./packages/ui/src/*"],
      "ahooks": ["../../packages/ui/node_modules/ahooks/lib/index.d.ts"],
      "react-router-dom": ["./src/renderer/shims/react-router-dom.tsx"],
      "@data/*": ["./src/renderer/data/*"],
      "@logger": ["./src/renderer/services/LoggerService"],
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"],
      "@test-mocks/*": ["./tests/__mocks__/*"],
      "@a3s-lab/flow-ui": ["../../crates/flow/packages/ui/src/index.ts"],
      "@a3s-lab/flow-ui/*": ["../../crates/flow/packages/ui/src/*"],
      "@a3s-lab/form": ["../../packages/form/src/index.ts"],
      "@a3s-lab/form/*": ["../../packages/form/src/*"],
      "@xyflow/react": ["./node_modules/@xyflow/react/dist/esm/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom/index.d.ts"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.web.tsbuildinfo"
  },
  "exclude": [
    "packages/aiCore/src/**/__tests__/**",
    "packages/ui/src/**/__tests__/**",
    "packages/ui/src/**/*.test.ts",
    "packages/ui/src/**/*.test.tsx"
  ],
  "include": [
    "local/src/renderer/**/*",
    "src/renderer/**/*",
    "tests/__mocks__/**/*",
    "packages/aiCore/src/**/*",
    "packages/ai-sdk-provider/**/*",
    "packages/extension-table-plus/**/*",
    "packages/provider-registry/**/*",
    "src/shared/**/*",
    "packages/ui/src/**/*"
  ]
}
