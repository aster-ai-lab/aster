extension "proof/composer" {
  schema_version = 3
  version = "1.0.0"
  requires_use = ">=0.3.0, <0.4.0"
  route = "proof-composer"
  actions = ["read"]
  repository {
    url = "https://example.org/proof/composer"
  }
  ui "normalize" {
    title = "Normalize"
    entry = "index.html"
    scripts = ["provider.js"]
    point = "studio.composer.actions"
  }
  ui "session-normalize" {
    title = "Session Normalize"
    entry = "index.html"
    scripts = ["provider.js"]
    point = "studio.composer.actions"
    scope = "session"
  }
}
