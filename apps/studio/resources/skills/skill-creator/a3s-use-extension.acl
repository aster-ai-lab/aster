extension "a3s/skill-creator" {
  schema_version = 3
  version        = "1.0.0"
  route          = "skill-creator"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://a3s.dev/packages/skills/skill-creator"
    revision = "0000000000000000000000000000000000000000"
  }

  skill "skill-creator" {
    path     = "SKILL.md"
    optional = false
  }
}
