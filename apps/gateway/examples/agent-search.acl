# Agent search on the unified gateway.
# This file is not loaded by a default gateway install.
# The running OS gateway is apps/api/gateway/gateway.acl.
#
# Start the backend with:
#   ASTER_SEARCH_API_KEY=search-upstream-secret aster-search serve --listen 127.0.0.1:8090
# Callers POST /v1/search. The gateway checks the caller key, then replaces
# Authorization with the deployment key before the request reaches search.

mode { kind = "standalone" }

entrypoints "web" {
  address = "127.0.0.1:8080"
}

routers "search" {
  rule        = "Path(`/v1/search`)"
  service     = "search"
  entrypoints = ["web"]
  middlewares = ["search-caller", "search-upstream-key"]
}

services "search" {
  load_balancer {
    strategy             = "least-connections"
    request_timeout      = "30s"
    stream_idle_timeout  = "5m"
    stream_total_timeout = "60m"
    health_check {
      path                = "/health"
      interval            = "5s"
      timeout             = "2s"
      unhealthy_threshold = 1
    }
    servers = [{ url = "http://127.0.0.1:8090" }]
  }
}

middlewares "search-caller" {
  type   = "api-key"
  header = "Authorization"
  keys   = ["Bearer caller-secret"]
}

middlewares "search-upstream-key" {
  type = "headers"
  request_headers = [
    { name = "Authorization", value = "Bearer ${ASTER_SEARCH_API_KEY}" }
  ]
}

observability {
  metrics_enabled    = false
  access_log_enabled = false
  tracing_enabled    = false
}
