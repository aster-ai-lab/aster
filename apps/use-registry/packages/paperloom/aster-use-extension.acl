extension "aster/paperloom" {
  schema_version = 3
  version        = "1.0.1"
  route          = "paperloom"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read", "mutate"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "8ecbce538177334882dc856fba151dc11aa934f6"
  }

  skill "paperloom" {
    path = "skills/paperloom/SKILL.md"
    host = "paperloom"
  }

  agent "paperloom" {
    harness        = "builtin"
    runtime        = "edge"
    instructions   = "agents/paperloom/INSTRUCTIONS.md"
    requires_skill = ["paperloom"]
    optional       = false

    resources {
      cpu_millis   = 500
      memory_bytes = 268435456
    }
  }
}
