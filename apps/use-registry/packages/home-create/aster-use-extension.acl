extension "aster/home-create" {
  schema_version = 3
  version        = "1.0.0"
  route          = "home-create"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  plugin "shelf" {
    entry    = "probe.txt"
    optional = true
  }


  home "ppt" {
    shelf       = "create"
    title       = "创作PPT"
    description = "创作演示文稿"
    order       = 10
    action      = "unavailable"
    cover       = "ppt"
  }
  home "site" {
    shelf       = "create"
    title       = "开发应用"
    description = "开发一个应用"
    order       = 20
    action      = "unavailable"
    cover       = "site"
  }
  home "video" {
    shelf       = "create"
    title       = "设计界面"
    description = "设计界面方案"
    order       = 30
    action      = "unavailable"
    cover       = "video"
  }
  home "image" {
    shelf       = "create"
    title       = "编制方案"
    description = "编制方案"
    order       = 40
    action      = "applet"
    applet      = "plan"
    cover       = "image"
  }
}
