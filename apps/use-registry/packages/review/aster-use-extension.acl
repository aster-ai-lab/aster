extension "aster/review" {
  schema_version = 3
  version        = "1.3.0"
  route          = "review"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "c1dcedcd84794ce4bb0010c8d17a7eff4c62d212"
  }

  skill "review" {
    path = "skills/review/SKILL.md"
    host = "docx-review"
  }

  agent "legal-expert" {
    harness        = "builtin"
    instructions   = "agents/legal-expert/INSTRUCTIONS.md"
    runtime        = "edge"
    requires_skill = ["review"]
    optional       = false

    resources {
      cpu_millis   = 500
      memory_bytes = 268435456
    }
  }

}
