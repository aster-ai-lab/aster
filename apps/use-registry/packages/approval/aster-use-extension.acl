extension "aster/approval" {
  schema_version = 3
  version        = "0.1.0"
  route          = "approval"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://aster.dev/packages/applets/approval"
    revision = "0000000000000000000000000000000000000000"
  }

  ui "approval" {
    point = "studio.applets"
    entry = "ui/home/index.html"
  }
}
