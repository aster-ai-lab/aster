extension "aster/iris" {
  schema_version = 3
  version        = "1.0.0"
  route          = "iris"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  skill "iris" {
    path          = "skills/iris/SKILL.md"
    requires_tool = []
    requires_mcp  = []
    optional      = false
  }

  agent "iris" {
    harness        = "package"
    runtime        = "edge"
    entry          = "agent/run.mjs"
    instructions   = "agents/iris/INSTRUCTIONS.md"
    requires_skill = ["iris"]
    optional       = false

    resources {
      cpu_millis   = 500
      memory_bytes = 268435456
    }
  }

  ui "workbench" {
    title            = "3DR iris 四旋翼"
    description      = "3DR iris 四旋翼 MuJoCo WASM 仿真实验台：空中巡航、外卖配送、设施巡检。每个决策点由本包 edge agent 经 aster 网关选择，agent 不可用时由规则控制器选择并标明。"
    icon             = "bot"
    entry            = "ui/workbench/index.html"
    root             = "ui/workbench"
    styles           = ["ui/workbench/app.css"]
    scripts          = ["ui/workbench/app.js"]
    skill            = "iris"
    presentation     = "webview"
    point            = "studio.applets"
    contract_version = 1
    mode             = "append"
    optional         = false
  }
}
