extension "aster/cobot-arm" {
  schema_version = 3
  version        = "1.0.0"
  route          = "cobot-arm"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  skill "cobot-arm" {
    path          = "skills/cobot-arm/SKILL.md"
    requires_tool = []
    requires_mcp  = []
    optional      = false
  }

  agent "cobot-arm" {
    harness        = "package"
    runtime        = "edge"
    entry          = "agent/run.mjs"
    instructions   = "agents/cobot-arm/INSTRUCTIONS.md"
    requires_skill = ["cobot-arm"]
    optional       = false

    resources {
      cpu_millis   = 500
      memory_bytes = 268435456
    }
  }

  ui "workbench" {
    title            = "七轴轻量化协作机器人"
    description      = "Franka Panda MuJoCo WASM 仿真实验台：搬运入盘、方块堆叠、越障搬运，每个决策点由本包 edge agent 经 aster 网关选择，agent 不可用时由规则控制器选择并标明。LIBERO libero_90 关闭抽屉、关闭微波炉由视觉模型看外部和腕部相机图规划航点，模型不可用时停止，不用规则替代。"
    icon             = "bot"
    entry            = "ui/workbench/index.html"
    root             = "ui/workbench"
    styles           = ["ui/workbench/app.css"]
    scripts          = ["ui/workbench/app.js"]
    skill            = "cobot-arm"
    presentation     = "webview"
    point            = "studio.applets"
    contract_version = 1
    mode             = "append"
    optional         = false
  }
}
