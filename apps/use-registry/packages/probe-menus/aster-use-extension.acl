extension "aster/probe-menus" {
  schema_version = 3
  version        = "1.0.0"
  route          = "probe-menus"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  plugin "probe" {
    entry    = "probe.txt"
    optional = true
  }

  command "probe" {
    title    = "扩展点菜单探针"
    category = "扩展点"
  }
  menu "commandPalette" {
    command = "probe"
    order   = 10
  }
  menu "editor/context" {
    command = "probe"
    order   = 11
  }
  menu "editor/title" {
    command = "probe"
    order   = 12
  }
}
