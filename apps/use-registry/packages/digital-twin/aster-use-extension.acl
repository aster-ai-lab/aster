extension "aster/digital-twin" {
  schema_version = 3
  version = "1.0.0"
  route = "digital-twin"
  requires_use = ">=0.3.0, <0.4.0"
  actions = ["read", "mutate"]

  repository {
    url = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  skill "twin-build" {
    path = "skills/twin-build/SKILL.md"
    requires_tool = []
    requires_mcp = []
    optional = false
  }

  agent "builder" {
    harness = "builtin"
    runtime = "edge"
    instructions = "agents/builder/INSTRUCTIONS.md"
    requires_skill = ["twin-build"]
    optional = false
    resources {
      cpu_millis = 1000
      memory_bytes = 536870912
    }
  }

  view_container "twin" {
    title = "数字孪生"
    icon = "panels"
    order = 70
    location = "activitybar"
  }

  ui "workbench" {
    title = "数字孪生编辑器"
    description = "构建场景、检查物体属性并保存到当前项目。"
    icon = "panels"
    entry = "ui/editor/index.html"
    root = "ui/editor"
    scripts = ["ui/editor/app.js"]
    styles = ["ui/editor/app.css"]
    presentation = "webview"
    container = "twin"
    contract_version = 1
    mode = "append"
    optional = false
  }

  ui "editor" {
    title = "数字孪生编辑器"
    icon = "panels"
    entry = "ui/editor/index.html"
    root = "ui/editor"
    scripts = ["ui/editor/app.js"]
    styles = ["ui/editor/app.css"]
    presentation = "webview"
    point = "studio.editor"
    contract_version = 1
    mode = "append"
    optional = false
  }

  composer_mode "build" {
    contract_version = 1
    title = "数字孪生"
    description = "根据当前项目和场景构建、检查及调整数字孪生。"
    icon = "panels"
    agent = "builder"
    editor = "editor"
    scope = "workspace"
    context = ["workspace", "document", "conversation"]
    order = 70
  }
}
