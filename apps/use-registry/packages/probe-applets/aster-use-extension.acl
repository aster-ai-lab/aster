extension "aster/probe-applets" {
  schema_version = 3
  version        = "1.0.0"
  route          = "probe-applets"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  ui "view" {
    title            = "小程序探针"
    description      = "打开小程序页面，可以看到这个入口。"
    icon             = "panels"
    entry            = "ui/view/index.html"
    presentation     = "webview"
    point            = "studio.applets"
    contract_version = 1
    mode             = "append"
  }
}
