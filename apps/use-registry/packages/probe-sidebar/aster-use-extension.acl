extension "aster/probe-sidebar" {
  schema_version = 3
  version        = "1.0.0"
  route          = "probe-sidebar"
  requires_use   = ">=0.3.0, <0.4.0"
  actions        = ["read"]

  repository {
    url      = "https://github.com/aster-ai-lab/Use-Registry"
    revision = "0000000000000000000000000000000000000000"
  }

  view_container "column" {
    title    = "侧栏探针"
    icon     = "files"
    order    = 81
    location = "activitybar"
  }

  ui "view" {
    title            = "侧栏探针"
    description      = "点击活动栏图标后，左侧栏显示这个标题。"
    icon             = "files"
    entry            = "ui/view/index.html"
    presentation     = "tree"
    container        = "column"
    contract_version = 1
    mode             = "append"
  }
}
