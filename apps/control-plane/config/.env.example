# HTTP
ASTER_CONFIG_HOST=127.0.0.1
ASTER_CONFIG_PORT=7652
# or: ASTER_CONFIG_LISTEN=127.0.0.1:7652

# PostgreSQL (owned by this process)
ASTER_CONFIG_DATABASE_URL=postgres://aster_config:aster_config@127.0.0.1:5432/aster_config
ASTER_CONFIG_DATABASE_POOL_SIZE=8

# Iggy — revision fan-out (stream aster_config, topic config_changed)
ASTER_CONFIG_IGGY_ADDRESS=127.0.0.1:5102
ASTER_CONFIG_IGGY_USERNAME=iggy
ASTER_CONFIG_IGGY_PASSWORD=iggy
