// Run the built unattended_e2e integration executable with
// --tui-arg provider_failures:: --tui-arg --test-threads=1 --tui-arg --nocapture.
suite "unattended-provider-retry" {
  version = 1

  scenario "real-acp-provider-failures-and-recovery" {
    surface = "tui"
    timeout_ms = 120000

    wait "all-provider-cases-pass" {
      text = "test result: ok. 3 passed; 0 failed"
    }
    expect "actual-acp-cases-ran" {
      text = "ORACLE issue=295"
    }
    terminal_recording "provider-results" {
      path = "terminal/provider-results.vt"
    }
  }
}
