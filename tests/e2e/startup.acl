suite "aster-startup" {
  version = 1

  scenario "logo-and-responsive-welcome" {
    surface = "tui"
    timeout_ms = 30000

    wait "welcome" {
      text = "Aster"
    }
    wait "ascii-star" {
      regex = "[#@*]{4}"
    }
    wait "animated-star" {
      regex = "@{2}"
    }
    snapshot "full-welcome" {}
    terminal_recording "logo-animation" {
      path = "terminal/aster-logo.vt"
    }
    terminal_resize "small-terminal" {
      columns = 60
      rows = 20
    }
    wait "small-welcome" {
      regex = "[0-9]+\\.[0-9]+\\.[0-9]+"
    }
    snapshot "small-snapshot" {}
    terminal_resize "standard-terminal" {
      columns = 80
      rows = 24
    }
    wait "standard-star" {
      regex = "[+*][#@][+*]    [+*]{2}"
    }
    snapshot "standard-snapshot" {}
  }
}
