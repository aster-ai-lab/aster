// Run the built unattended_e2e integration executable with
// --tui-arg permission_modes:: --tui-arg=--test-threads=1 --tui-arg=--nocapture.
suite "interactive-permission-modes" {
  version = 1

  scenario "interactive-mode-boundaries" {
    surface = "tui"
    timeout_ms = 120000

    wait "all-interactive-cases-pass" {
      text = "test result: ok. 2 passed; 0 failed"
    }
    expect "full-access-without-confirmation" {
      text = "PERMISSION_ORACLE mode=yolo operation=host asks=0"
    }
    expect "rejection-without-execution" {
      text = "PERMISSION_REJECTION mode=default asks=1 executed=false"
    }
    terminal_recording "permission-results" {
      path = "terminal/permission-results.vt"
    }
  }
}
